        "family": "helm-value",
        "product": "cilium",
        "path": "proxy.prometheus.enabled"
      },
      "change": {
        "type": "removed",
        "replacedBy": {
          "family": "helm-value",
          "product": "cilium",
          "path": "envoy.prometheus.enabled"
        }
      },
      "applicability": {
        "exposure": {
          "op": "values-key",
          "path": "proxy.prometheus.enabled",
          "state": "set"
        }
      },
      "consequence": {
        "kind": "setting-ignored",
        "exposedClass": "action-required",
        "statement": "Values set under `proxy.prometheus.enabled` and `proxy.prometheus.port` are no longer honoured after the upgrade because the options have been removed; the equivalent settings must be provided via `envoy.prometheus.enabled` and `envoy.prometheus.port`.",
        "remediation": "Move any `proxy.prometheus.enabled` and `proxy.prometheus.port` settings in your Helm values to `envoy.prometheus.enabled` and `envoy.prometheus.port` when upgrading to 1.16.0.",
        "severity": "medium"
      },
      "statement": "Deprecated options `proxy.prometheus.enabled` and `proxy.prometheus.port` have been removed"
    },
