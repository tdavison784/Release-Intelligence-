    "assertion": {
      "subject": {
        "family": "protocol-behavior",
        "product": "cilium",
        "name": "terminatingtls-ca-crt-loading"
      },
      "change": {
        "type": "behavior-changed"
      },
      "applicability": {
        "exposure": {
          "op": "all",
          "of": [
            {
              "op": "cli-flag",
              "name": "--use-full-tls-context",
              "component": "cilium",
              "state": "unset"
            },
            {
              "op": "undecidable",
              "reason": "environment-visibility-gap",
              "needed": "whether environment uses L7 network policies with terminatingTLS that rely on ca.crt loading"
            }
          ]
        }
      },
      "consequence": {
        "kind": "behavior-change",
        "exposedClass": "review-required",
        "statement": "L7 network policies with terminatingTLS will no longer load ca.crt from secrets by default, preventing Envoy from incorrectly requiring client certificates; environments relying on the old behavior must set --use-full-tls-context=true.",
        "remediation": "If the old behavior is required for compatibility, set --use-full-tls-context=true when running cilium",
        "severity": "medium"
      },
      "statement": "L7 network policy with terminatingTLS will not load the key `ca.crt` even if it is present in the secret"
    },
