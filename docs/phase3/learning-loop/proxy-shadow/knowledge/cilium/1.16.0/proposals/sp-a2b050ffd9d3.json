      "consequence": {
        "kind": "behavior-change",
        "exposedClass": "review-required",
        "statement": "The Envoy DaemonSet is now enabled by default, adding one Pod per Node; nodes at maximum Pod capacity will experience eviction of a single non-system critical Pod after upgrading.",
        "remediation": "Set upgradeCompatibility to 1.15 or earlier to retain the previous behavior, or set envoy.enabled explicitly to false to disable the Envoy DaemonSet and prevent the additional Pod per Node.",
