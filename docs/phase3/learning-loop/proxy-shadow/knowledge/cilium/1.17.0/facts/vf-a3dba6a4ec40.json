      "consequence": {
        "kind": "behavior-change",
        "exposedClass": "review-required",
        "statement": "The Cilium Operator's Kubernetes client now uses a default rate limit of 100 QPS/200 Burst, which may differ from previous agent-level defaults; operators can now independently configure these rates using the new --operator-k8s-client-qps and --operator-k8s-client-burst flags.",
        "severity": "medium"
      },
      "statement": "The Kubernetes clients used by Cilium Agent and Cilium Operator now have separately configurable rate limits"
