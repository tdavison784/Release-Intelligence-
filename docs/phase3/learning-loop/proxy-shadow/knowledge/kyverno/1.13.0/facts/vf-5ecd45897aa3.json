      "consequence": {
        "kind": "behavior-change",
        "exposedClass": "review-required",
        "statement": "GlobalContextEntry apiCall data fetches that initially fail are now retried up to 3 times by default (configurable via the new optional spec.apiCall.retryLimit field), so external-data retrieval behaves differently on transient failures; existing resources remain valid since the field is optional.",
        "remediation": "No action required; optionally set spec.apiCall.retryLimit to tune the number of retries.",
        "severity": "low"
      },
      "statement": "API Call Retry: Kyverno’s GlobalContextEntry provides a powerful mechanism to fetch external data and use it within policies"
