              "kind": "PolicyException"
            },
            {
              "op": "undecidable",
              "reason": "evidence-gap",
              "needed": "whether the installation explicitly enables policy exceptions and sets the allowed namespace; the controlling configuration key is not named in the evidence"
            }
          ]
        }
      },
      "statement": "Kyverno 1.13.0 changes its defaults so policy exceptions are disabled and may only be created in a specified namespace (previously allowed in all namespaces, CVE-2024-48921); environments relying on PolicyExceptions must follow the upgrade guidance to keep them working."
    },
    "corrected": {
      "applicability": {
        "exposure": {
          "op": "all",
          "of": [
            {
              "op": "gvk-in-use",
              "group": "kyverno.io",
              "kind": "PolicyException"
            },
            {
              "op": "rendered-change",
              "group": "apps",
              "kind": "Deployment",
              "path": "spec.template.spec.containers[].args",
              "state": "changed",
              "values": [
                "\"--enablePolicyException=false\""
              ]
            }
          ]
        }
      },
      "statement": "Kyverno 1.13.0 turns policy exceptions off by default: the chart now renders --enablePolicyException=false, where it rendered true before. Exposed: environments that use kyverno.io PolicyException resources and whose rendered controller args change to --enablePolicyException=false under their own values."
    },
