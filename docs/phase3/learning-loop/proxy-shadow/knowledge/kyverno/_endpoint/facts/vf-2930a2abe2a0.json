    ],
    "assertion": {
      "subject": {
        "family": "migration",
        "product": "kyverno",
        "name": "clustercleanuppolicies-storage-version-migration"
      },
      "change": {
        "type": "migration-required"
      },
      "applicability": {
        "exposure": {
          "op": "resource",
          "of": [
            {
              "op": "field",
              "path": "status.storedVersions[]",
              "state": "equals",
              "values": [
                "\"v2beta1\""
              ]
            }
          ],
          "group": "apiextensions.k8s.io",
          "kind": "CustomResourceDefinition",
          "name": "clustercleanuppolicies.kyverno.io"
        }
      },
      "consequence": {
        "kind": "behavior-change",
        "exposedClass": "review-required",
        "statement": "After the upgrade, new or rewritten ClusterCleanupPolicy objects are stored as v2, while existing objects stay stored as v2beta1 until rewritten. The evidence does not state that anything fails or is rejected in this release.",
        "remediation": "Optionally run a storage version migration (re-write all ClusterCleanupPolicy objects) and update status.storedVersions on the CRD, so that a future removal of v2beta1 does not leave stale stored objects.",
        "severity": "low"
      },
      "statement": "Storage version of `clustercleanuppolicies.kyverno.io` changes v2beta1 → v2"
    },
    "verification": [
