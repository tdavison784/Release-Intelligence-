    "assertion": {
      "subject": {
        "family": "migration",
        "product": "kyverno",
        "name": "clustercleanuppolicies-storage-version-migration"
      },
      "change": {
        "type": "migration-required"
      },
      "applicability": {
        "exposure": {
          "op": "all",
          "of": [
            {
              "op": "gvk-in-use",
              "group": "kyverno.io",
              "kind": "ClusterCleanupPolicy"
            },
            {
              "op": "edge-from-version",
              "state": "in-range",
              "range": "<1.13.0"
            }
          ]
        }
      },
      "consequence": {
        "kind": "behavior-change",
        "exposedClass": "review-required",
        "statement": "Nothing fails on upgrade. The CRD stores ClusterCleanupPolicy objects as v2 from now on, and existing objects stay stored as v2beta1 until they are rewritten. v2beta1 stays defined in the CRD, so existing objects keep working.",
        "remediation": "Optionally run a storage version migration (rewrite all ClusterCleanupPolicy objects), then remove v2beta1 from status.storedVersions on the CRD before any future release that removes v2beta1.",
        "severity": "low"
      },
      "statement": "Storage version of `clustercleanuppolicies.kyverno.io` changes v2beta1 → v2"
    },
