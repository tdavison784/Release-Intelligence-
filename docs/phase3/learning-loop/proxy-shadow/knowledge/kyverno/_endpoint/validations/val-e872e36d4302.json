    "assertion": {
      "subject": {
        "family": "gvk",
        "product": "kyverno",
        "group": "kyverno.io",
        "version": "v2beta1",
        "kind": "PolicyException"
      },
      "change": {
        "type": "behavior-changed"
      },
      "applicability": {
        "exposure": {
          "op": "any",
          "of": [
            {
              "op": "gvk-in-use",
              "group": "kyverno.io",
              "version": "v2beta1",
              "kind": "PolicyException"
            },
            {
              "op": "undecidable",
              "reason": "runtime-behavior-gap",
              "needed": "whether existing PolicyException objects are stored in v2beta1 format in etcd"
            }
          ]
        }
      },
      "consequence": {
        "kind": "migration-required",
        "exposedClass": "action-required",
        "statement": "Existing PolicyException objects remain stored in v2beta1 format and must be migrated by running a storage version migration to rewrite all objects and update status.storedVersions before v2beta1 support is removed in a later release."
      },
      "statement": "The storage version of policyexceptions.kyverno.io changes from v2beta1 to v2; existing objects stored as v2beta1 must be migrated by running a storage version migration before v2beta1 is removed."
    },
    "checks": [
      {
        "aspect": "subject",
        "outcome": "confirmed",
        "rule": "crd-schema:gvk",
        "detail": "kyverno.io/v2beta1 PolicyException is an API version in both releases"
      },
      {
        "aspect": "change",
        "outcome": "inconclusive",
        "rule": "crd-schema:behavior-changed",
        "detail": "a behavior-changed change of an API version is not decidable from CRD snapshots"
      }
    ],
