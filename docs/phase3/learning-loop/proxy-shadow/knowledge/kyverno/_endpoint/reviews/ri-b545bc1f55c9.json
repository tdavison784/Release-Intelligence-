    "question": "For \"Storage version of `updaterequests.kyverno.io` changes v1beta1 → v2\", which environments are exposed? Confirm or correct the exposure condition.",
    "proposed": {
      "applicability": {
        "exposure": {
          "op": "resource",
          "of": [
            {
              "op": "field",
              "path": "status.storedVersions[]",
              "state": "equals",
              "values": [
