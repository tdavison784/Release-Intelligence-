    "original": {
      "applicability": {
        "exposure": {
          "op": "undecidable",
          "reason": "runtime-behavior-gap",
          "needed": "whether dashboards, alert rules, or PromQL/queries reference the metric name cortex_query_scheduler_queue_duration_seconds_sum; monitoring definitions live outside the Loki release and no release input carries them"
        }
      },
      "statement": "The Loki 3.0.0 upgrade guide lists the metric `cortex_query_scheduler_queue_duration_seconds_sum` under its 'Metrics namespace' section, but the evidence does not state what changed for it, and exposure depends on whether external dashboards, alerts, or queries reference that metric name, which no release input carries."
    },
    "corrected": {
      "applicability": {
        "exposure": {
          "op": "not",
          "of": [
            {
              "op": "resource",
              "of": [
                {
                  "op": "text-line",
                  "path": "data[\"config.yaml\"]",
                  "state": "exists",
                  "pattern": "^\\s*metrics_namespace:\\s*[\"']?cortex[\"']?\\s*$"
                }
              ],
              "kind": "ConfigMap"
            }
          ]
        },
        "overlap": {
          "op": "resource",
          "of": [
            {
              "op": "text-line",
              "path": "data[\"config.yaml\"]",
              "state": "exists",
              "pattern": "^\\s*metrics_namespace:\\s*[\"']?cortex[\"']?\\s*$"
            }
          ],
          "kind": "ConfigMap"
        }
      },
      "statement": "In Loki 3.0.0, `cortex_query_scheduler_queue_duration_seconds_sum` is exposed as `loki_query_scheduler_queue_duration_seconds_sum` unless `metrics_namespace` is set to `cortex`. Environments that leave `metrics_namespace` at its default (`loki`) are exposed. Environments that set it to `cortex` keep the old name."
    },
