      "consequence": {
        "kind": "migration-required",
        "exposedClass": "action-required",
        "statement": "Loki 3.0.0 removes `-tsdb.shipper.shared-store.key-prefix` and its YAML setting. The index path prefix is now set by `path_prefix` under the `index` key in period_config. If the removed setting was configured to a value other than `index/`, all existing period configs that use `tsdb` as the index must have `path_prefix` set to the earlier value.",
        "remediation": "Before upgrading, remove `-tsdb.shipper.shared-store.key-prefix` (or its YAML setting). In every existing period config that uses `tsdb` as the index, set `index.path_prefix` to the value the flag had.",
