      "consequence": {
        "kind": "migration-required",
        "exposedClass": "action-required",
        "statement": "Strimzi 0.46.0 no longer supports ZooKeeper-based Kafka clusters, and migration from ZooKeeper to KRaft is no longer supported either. An environment with ZooKeeper-based clusters must move every cluster to KRaft before upgrading to Strimzi 0.46.0 or newer, because 0.46.0 can neither run nor migrate them.",
        "remediation": "Before upgrading to Strimzi 0.46.0, migrate every ZooKeeper-based Kafka cluster to KRaft while still on a Strimzi version that supports the migration, and finish any migration already in progress.",
        "severity": "high"
      },
      "statement": "Support for ZooKeeper-based Apache Kafka clusters and for KRaft migration has been removed"
    },
