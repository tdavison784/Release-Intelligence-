    "assertion": {
      "subject": {
        "family": "protocol-behavior",
        "product": "strimzi",
        "name": "statefulset-pod-name-label"
      },
      "change": {
        "type": "removed",
        "replacedBy": {
          "family": "protocol-behavior",
          "product": "strimzi",
          "name": "strimzi-pod-name-label"
        }
      },
      "applicability": {
        "exposure": {
          "op": "any",
          "of": [
            {
              "op": "resource",
              "of": [
                {
                  "op": "field",
                  "path": "spec.selector[\"statefulset.kubernetes.io/pod-name\"]",
                  "state": "set"
                }
              ],
              "kind": "Service"
            },
            {
              "op": "resource",
              "of": [
                {
                  "op": "field",
                  "path": "spec.podSelector.matchLabels[\"statefulset.kubernetes.io/pod-name\"]",
                  "state": "set"
                }
              ],
              "group": "networking.k8s.io",
              "kind": "NetworkPolicy"
            },
            {
              "op": "undecidable",
              "reason": "evidence-gap",
              "needed": "which other custom setups (external tooling, scripts, monitoring) read the statefulset.kubernetes.io/pod-name label from Strimzi pods or external listener Services"
            }
          ]
        }
      },
      "consequence": {
        "kind": "migration-required",
        "exposedClass": "action-required",
        "statement": "After the upgrade, Strimzi pods and external listener Kubernetes Services no longer carry the statefulset.kubernetes.io/pod-name label, so any custom setup that uses this label must be changed to use the strimzi.io/pod-name label instead.",
        "remediation": "Update any custom setup that uses the statefulset.kubernetes.io/pod-name label to use the strimzi.io/pod-name label instead.",
        "severity": "medium"
      },
      "statement": "Removed the `statefulset.kubernetes.io/pod-name` label from pods and external listeners Kubernetes Services"
