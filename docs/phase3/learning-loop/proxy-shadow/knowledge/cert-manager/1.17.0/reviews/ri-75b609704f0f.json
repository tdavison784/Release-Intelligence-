    "product": "cert-manager",
    "release": "1.17.0",
    "questionType": "applicability",
    "question": "For \"RSA certificates with keys of length 3072 or 4096 will now use SHA-384 or SHA-512 respectively as hash algorithms\", which environments are exposed? Confirm or correct the exposure condition.",
    "proposed": {
      "applicability": {
        "exposure": {
          "op": "all",
          "of": [
            {
              "op": "resource",
              "of": [
                {
                  "op": "field",
                  "path": "spec.privateKey.size",
                  "state": "equals",
                  "values": [
                    "3072",
                    "4096"
                  ]
                }
              ],
              "group": "cert-manager.io",
              "kind": "Certificate"
            },
            {
              "op": "undecidable",
              "reason": "runtime-behavior-gap",
              "needed": "whether systems that consume or validate these certificates fail to handle SHA-384/SHA-512 signatures"
            }
          ]
        }
      },
      "statement": "From cert-manager 1.17.0, RSA certificates with 3072-bit keys use SHA-384 and those with 4096-bit keys use SHA-512 as the hash algorithm. Operators should check for errors as these larger RSA keys rotate."
    },
