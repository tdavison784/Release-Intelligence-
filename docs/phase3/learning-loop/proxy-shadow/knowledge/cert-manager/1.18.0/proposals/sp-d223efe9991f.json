      "consequence": {
        "kind": "behavior-change",
        "exposedClass": "review-required",
        "statement": "On upgrade to cert-manager 1.18, stale CertificateRequest revisions beyond the new default limit of 1 are automatically garbage collected for Certificates that do not explicitly set spec.revisionHistoryLimit; Certificates that explicitly set revisionHistoryLimit are unaffected.",
        "remediation": "If you rely on keeping more CertificateRequest revision history, explicitly set spec.revisionHistoryLimit to a higher value on your Certificate resources before upgrading to cert-manager 1.18.",
        "severity": "medium"
      },
      "statement": "cert-manager 1.18 changes the default of the Certificate field spec.revisionHistoryLimit from nil (no limit) to 1, so old CertificateRequest revisions are automatically garbage collected on upgrade unless the Certificate explicitly sets revisionHistoryLimit."
