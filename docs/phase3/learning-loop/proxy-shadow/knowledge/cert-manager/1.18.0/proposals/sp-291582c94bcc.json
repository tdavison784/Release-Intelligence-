    "provider": "anthropic",
    "assertion": {
      "subject": {
        "family": "protocol-behavior",
        "product": "cert-manager",
        "name": "http01-ingress-pathtype"
      },
      "change": {
        "type": "behavior-changed",
        "after": "\"Exact\""
      },
      "applicability": {
        "exposure": {
          "op": "any",
          "of": [
            {
              "op": "product-version",
              "name": "ingress-nginx",
              "state": "in-range",
              "range": ">=1.12.0"
            },
            {
              "op": "all",
              "of": [
                {
                  "op": "product-version",
                  "name": "ingress-nginx",
                  "state": "in-range",
                  "range": ">=1.8.0"
                },
                {
                  "op": "resource",
                  "of": [
                    {
                      "op": "field",
                      "path": "data[\"strict-validate-path-type\"]",
                      "state": "equals",
                      "values": [
                        "\"true\""
                      ]
                    }
                  ],
                  "kind": "ConfigMap"
                }
              ]
            }
          ]
        }
      },
      "consequence": {
        "kind": "workload-failure",
        "exposedClass": "action-required",
        "statement": "When strict-validate-path-type is enabled in ingress-nginx, its admission webhook validate.nginx.ingress.kubernetes.io rejects the challenge Ingress because the /.well-known/acme-challenge/<TOKEN> path contains a dot. The cert-manager controller then logs \"Error presenting challenge\", and the HTTP01 challenge cannot be solved.",
        "severity": "high"
      },
      "statement": "In cert-manager 1.18.0, Ingress routes for ACME HTTP01 challenges use PathType Exact. This breaks with ingress-nginx >=1.8.0 when strict-validate-path-type is enabled, which is the default from ingress-nginx 1.12.0: its admission webhook rejects the challenge path because it contains a dot, so the challenge cannot be presented."
    },
    "suggestedClass": "action-required",
