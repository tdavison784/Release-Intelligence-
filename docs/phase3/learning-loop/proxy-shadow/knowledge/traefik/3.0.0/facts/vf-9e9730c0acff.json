        ]
      }
    ],
    "candidates": [
      "sc-f6497dd8df3e"
    ],
    "assertion": {
      "subject": {
        "family": "config-key",
        "product": "traefik",
        "path": "consul.namespace"
      },
      "change": {
        "type": "removed",
        "replacedBy": {
          "family": "config-key",
          "product": "traefik",
          "path": "consul.namespaces"
        }
      },
      "applicability": {
        "exposure": {
          "op": "any",
          "of": [
            {
              "op": "cli-flag",
              "name": "--consul.namespace",
              "state": "set"
            },
            {
              "op": "resource",
              "of": [
                {
                  "op": "any",
                  "of": [
                    {
                      "op": "text-line",
                      "path": "data[\"traefik.yml\"]",
                      "state": "exists",
                      "pattern": "^\\s*namespace\\s*:"
                    },
                    {
                      "op": "text-line",
                      "path": "data[\"traefik.yaml\"]",
                      "state": "exists",
                      "pattern": "^\\s*namespace\\s*:"
                    },
                    {
                      "op": "text-line",
                      "path": "data[\"traefik.toml\"]",
                      "state": "exists",
                      "pattern": "^\\s*namespace\\s*="
                    }
                  ]
                }
              ],
              "kind": "ConfigMap"
            }
          ]
        }
      },
      "consequence": {
        "kind": "upgrade-blocked",
        "exposedClass": "action-required",
        "statement": "Traefik will fail to start if the Consul provider `namespace` option is set.",
        "severity": "critical"
      },
      "statement": "namespace: The Consul provider `namespace` option was deprecated in v2 and is now removed in v3"
    },
