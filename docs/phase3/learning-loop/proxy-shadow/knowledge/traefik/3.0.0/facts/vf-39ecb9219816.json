    "assertion": {
      "subject": {
        "family": "config-key",
        "product": "traefik",
        "path": "providers.kubernetesGateway.experimentalChannel"
      },
      "change": {
        "type": "behavior-changed"
      },
      "applicability": {
        "exposure": {
          "op": "all",
          "of": [
            {
              "op": "values-key",
              "path": "providers.kubernetesGateway",
              "state": "set"
            },
            {
              "op": "not",
              "of": [
                {
                  "op": "values-key",
                  "path": "providers.kubernetesGateway.experimentalChannel",
                  "state": "equals",
                  "values": [
                    "true",
                    "\"true\""
                  ]
                }
              ]
            },
            {
              "op": "any",
              "of": [
                {
                  "op": "gvk-in-use",
                  "kind": "TLSRoute"
                },
                {
                  "op": "gvk-in-use",
                  "kind": "TCPRoute"
                }
              ]
            }
          ]
        },
        "overlap": {
          "op": "values-key",
          "path": "providers.kubernetesGateway.experimentalChannel",
          "state": "equals",
          "values": [
            "true",
            "\"true\""
          ]
        }
      },
      "consequence": {
        "kind": "workload-failure",
        "exposedClass": "action-required",
        "statement": "Unless experimentalChannel is enabled, the Kubernetes Gateway API provider does not support TLSRoute and TCPRoute resources, so routing defined by them is no longer provided after the upgrade to v3.",
        "remediation": "Set providers.kubernetesGateway.experimentalChannel: true in the static configuration.",
        "severity": "high"
      },
      "statement": "Experimental Channel Resources (TLSRoute and TCPRoute): In v3, the Kubernetes Gateway API provider does not enable support for the experimental channel API…"
    },
