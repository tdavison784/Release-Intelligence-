    ],
    "assertion": {
      "subject": {
        "family": "migration",
        "product": "karpenter",
        "name": "ec2nodeclasses-storage-version-migration"
      },
      "change": {
        "type": "migration-required"
      },
      "applicability": {
        "exposure": {
          "op": "resource",
          "of": [
            {
              "op": "field",
              "path": "status.storedVersions[]",
              "state": "equals",
              "values": [
                "\"v1beta1\""
              ]
            }
          ],
          "group": "apiextensions.k8s.io",
          "kind": "CustomResourceDefinition",
          "name": "ec2nodeclasses.karpenter.k8s.aws"
        }
      },
      "consequence": {
        "kind": "deprecation",
        "exposedClass": "review-required",
        "statement": "Existing EC2NodeClass objects stay stored as v1beta1 until they are rewritten. They must be migrated to v1, and status.storedVersions updated, before a later release removes v1beta1.",
        "remediation": "Run a storage version migration that rewrites all EC2NodeClass objects, then update status.storedVersions on the ec2nodeclasses.karpenter.k8s.aws CRD.",
        "severity": "medium"
      },
      "statement": "Storage version of `ec2nodeclasses.karpenter.k8s.aws` changes v1beta1 → v1"
    },
