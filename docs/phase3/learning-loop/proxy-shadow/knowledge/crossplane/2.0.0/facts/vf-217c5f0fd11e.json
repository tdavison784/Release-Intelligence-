      "consequence": {
        "kind": "migration-required",
        "exposedClass": "action-required",
        "statement": "The `--registry` flag for a default package registry is removed and all packages must now use fully qualified names including the registry host name. The upgrade guide requires updating any package without a registry host name before upgrading.",
        "remediation": "Run `kubectl get pkg -o wide` and, before upgrading, update any package reference without a registry host name to a fully qualified name, e.g. `crossplane-contrib/provider-aws-s3:v1.23.0` -> `xpkg.crossplane.io/crossplane-contrib/provider-aws-s3:v1.23.0`.",
        "severity": "high"
      },
      "statement": "Default registry flag: Removed: `--registry` flag for default package registry All packages must now use fully qualified names including the registry host name"
    },
