    "assertion": {
      "subject": {
        "family": "migration",
        "product": "flux",
        "name": "imagerepository-storage-version-migration"
      },
      "change": {
        "type": "migration-required"
      },
      "applicability": {
        "exposure": {
          "op": "any",
          "of": [
            {
              "op": "gvk-in-use",
              "group": "image.toolkit.fluxcd.io",
              "version": "v1beta2",
              "kind": "ImageRepository"
            },
            {
              "op": "gvk-in-use",
              "group": "image.toolkit.fluxcd.io",
              "version": "v1",
              "kind": "ImageRepository"
            }
          ]
        }
      },
      "consequence": {
        "kind": "deprecation",
        "exposedClass": "review-required",
        "statement": "If the operator does nothing, existing ImageRepository objects stay stored as v1beta2 and keep working in this release. They are only at risk once a later release removes v1beta2 while v1beta2 is still listed in status.storedVersions.",
        "remediation": "Before upgrading to a release that removes v1beta2, rewrite all ImageRepository objects so they are stored as v1. Then update status.storedVersions on the imagerepositories.image.toolkit.fluxcd.io CRD to drop v1beta2.",
        "severity": "low"
      },
      "statement": "Storage version of `imagerepositories.image.toolkit.fluxcd.io` changes v1beta2 → v1"
    },
