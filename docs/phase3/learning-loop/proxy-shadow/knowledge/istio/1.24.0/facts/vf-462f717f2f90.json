    "assertion": {
      "subject": {
        "family": "protocol-behavior",
        "product": "istio",
        "name": "grpc-control-plane-alpn-validation"
      },
      "change": {
        "type": "behavior-changed"
      },
      "applicability": {
        "exposure": {
          "op": "all",
          "of": [
            {
              "op": "product-version",
              "name": "cert-manager-istio-csr",
              "state": "in-range",
              "range": "<=0.12.0"
            },
            {
              "op": "not",
              "of": [
                {
                  "op": "env-var",
                  "name": "GRPC_ENFORCE_ALPN_ENABLED",
                  "state": "equals",
                  "values": [
                    "\"false\""
                  ]
                }
              ]
            }
          ]
        },
        "overlap": {
          "op": "all",
          "of": [
            {
              "op": "product-version",
              "name": "cert-manager-istio-csr",
              "state": "in-range",
              "range": "<=0.12.0"
            },
            {
              "op": "env-var",
              "name": "GRPC_ENFORCE_ALPN_ENABLED",
              "state": "equals",
              "values": [
                "\"false\""
              ]
            }
          ]
        }
      },
      "consequence": {
        "kind": "workload-failure",
        "exposedClass": "action-required",
        "statement": "If istio-csr (v0.12.0, without the fix) is used as the CA, Istio's gRPC connection fails with 'transport: authentication handshake failed: credentials: cannot check peer: missing selected ALPN property'.",
        "remediation": "Install Istio with the workaround settings given in the upgrade notes, or use an istio-csr version containing the upstream fix.",
        "severity": "high"
      },
      "statement": "Compatibility with cert-manager's `istio-csr`: In this release, Istio introduces increased validation checks in gRPC communication to the control plane"
