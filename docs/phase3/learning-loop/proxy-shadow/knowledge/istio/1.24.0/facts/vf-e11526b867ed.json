    "assertion": {
      "subject": {
        "family": "env-var",
        "product": "istio",
        "name": "PREFER_DESTINATIONRULE_TLS_FOR_EXTERNAL_SERVICES"
      },
      "change": {
        "type": "behavior-changed"
      },
      "applicability": {
        "exposure": {
          "op": "all",
          "of": [
            {
              "op": "resource",
              "of": [
                {
                  "op": "field",
                  "path": "spec.location",
                  "state": "equals",
                  "values": [
                    "\"MESH_EXTERNAL\""
                  ]
                }
              ],
              "group": "networking.istio.io",
              "kind": "ServiceEntry"
            },
            {
              "op": "any",
              "of": [
                {
                  "op": "resource",
                  "of": [
                    {
                      "op": "field",
                      "path": "spec.trafficPolicy.tls",
                      "state": "set"
                    }
                  ],
                  "group": "networking.istio.io",
                  "kind": "DestinationRule"
                },
                {
                  "op": "resource",
                  "of": [
                    {
                      "op": "field",
                      "path": "spec.trafficPolicy.portLevelSettings[].tls",
                      "state": "set"
                    }
                  ],
                  "group": "networking.istio.io",
                  "kind": "DestinationRule"
                }
              ]
            },
            {
              "op": "not",
              "of": [
                {
                  "op": "env-var",
                  "name": "PREFER_DESTINATIONRULE_TLS_FOR_EXTERNAL_SERVICES",
                  "state": "equals",
                  "values": [
                    "\"false\""
                  ]
                }
              ]
            }
          ]
        },
        "overlap": {
          "op": "all",
          "of": [
            {
              "op": "resource",
              "of": [
                {
                  "op": "field",
                  "path": "spec.location",
                  "state": "equals",
                  "values": [
                    "\"MESH_EXTERNAL\""
                  ]
                }
              ],
              "group": "networking.istio.io",
              "kind": "ServiceEntry"
            },
            {
              "op": "env-var",
              "name": "PREFER_DESTINATIONRULE_TLS_FOR_EXTERNAL_SERVICES",
              "state": "equals",
              "values": [
                "\"false\""
              ]
            }
          ]
        }
      },
      "consequence": {
        "kind": "behavior-change",
        "exposedClass": "review-required",
        "statement": "MESH_EXTERNAL services will use Destination Rule certificates instead of metadata certificates by default. This changes TLS certificate handling behavior for external services unless the environment variable is explicitly set to false.",
        "remediation": "Set PREFER_DESTINATIONRULE_TLS_FOR_EXTERNAL_SERVICES to 'false' to retain the previous metadata certificate behavior.",
        "severity": "medium"
      },
      "statement": "Added support for honouring Destination Rule Certificates for MESH_EXTERNAL services instead of Metadata certificates"
    },
