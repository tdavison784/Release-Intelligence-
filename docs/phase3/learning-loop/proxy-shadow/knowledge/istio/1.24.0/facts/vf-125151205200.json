        "name": "default-retry-policy-503"
      },
      "change": {
        "type": "behavior-changed"
      },
      "applicability": {
        "exposure": {
          "op": "not",
          "of": [
            {
              "op": "env-var",
              "name": "EXCLUDE_UNSAFE_503_FROM_DEFAULT_RETRY",
              "state": "equals",
              "values": [
                "\"false\""
              ]
