        "overlap": {
          "op": "env-var",
          "name": "EXCLUDE_UNSAFE_503_FROM_DEFAULT_RETRY",
          "state": "equals",
          "values": [
            "\"false\""
          ]
        }
      },
      "consequence": {
        "kind": "behavior-change",
        "exposedClass": "review-required",
        "statement": "The default retry policy no longer retries requests on 503 responses; set EXCLUDE_UNSAFE_503_FROM_DEFAULT_RETRY to false to restore the old behavior (temporary flag).",
        "remediation": "Verify workloads relying on default 503 retries; set EXCLUDE_UNSAFE_503_FROM_DEFAULT_RETRY=false if needed, knowing the flag will be removed.",
        "severity": "low"
      },
      "statement": "Fixed default retry policy to exclude retries on 503 which is potentially unsafe for idempotent requets"
    },
