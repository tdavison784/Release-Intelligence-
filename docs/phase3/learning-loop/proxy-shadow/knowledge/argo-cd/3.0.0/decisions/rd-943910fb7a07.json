    "original": {
      "applicability": {
        "exposure": {
          "op": "all",
          "of": [
            {
              "op": "gvk-in-use",
              "group": "argoproj.io",
              "version": "v1alpha1",
              "kind": "Application"
            },
            {
              "op": "any",
              "of": [
                {
                  "op": "values-key",
                  "path": "controller.resource.health.persist",
                  "state": "unset"
                },
                {
                  "op": "resource",
                  "of": [
                    {
                      "op": "field",
                      "path": "status.resourceHealthSource",
                      "state": "equals",
                      "values": [
                        "\"\""
                      ]
                    }
                  ],
                  "group": "argoproj.io",
                  "version": "v1alpha1",
                  "kind": "Application"
                }
              ]
            }
          ]
        },
        "overlap": {
          "op": "values-key",
          "path": "controller.resource.health.persist",
          "state": "equals",
          "values": [
            "true"
          ]
        }
      },
      "statement": "The health status is no longer persisted in the Application CR's `/status` by default in 3.0.0; it is stored externally instead, and can be reverted by setting `controller.resource.health.persist` to `true` in the `argocd-cmd-params-cm.yaml` ConfigMap."
    },
    "corrected": {
      "applicability": {
        "exposure": {
          "op": "all",
          "of": [
            {
              "op": "gvk-in-use",
              "group": "argoproj.io",
              "version": "v1alpha1",
              "kind": "Application"
            },
            {
              "op": "not",
              "of": [
                {
                  "op": "resource",
                  "of": [
                    {
                      "op": "field",
                      "path": "data[\"controller.resource.health.persist\"]",
                      "state": "set"
                    }
                  ],
                  "kind": "ConfigMap",
                  "name": "argocd-cmd-params-cm"
                }
              ]
            }
          ]
        },
        "overlap": {
          "op": "resource",
          "of": [
            {
              "op": "field",
              "path": "data[\"controller.resource.health.persist\"]",
              "state": "equals",
              "values": [
                "\"true\""
              ]
            }
          ],
          "kind": "ConfigMap",
          "name": "argocd-cmd-params-cm"
        }
      },
      "statement": "In Argo CD 3.0.0, per-resource health is no longer persisted under the Application CR's status by default. Exposed environments are those using Applications where the argocd-cmd-params-cm ConfigMap does not set controller.resource.health.persist. Environments that set it to \"true\" keep the old persisting behaviour."
    },
