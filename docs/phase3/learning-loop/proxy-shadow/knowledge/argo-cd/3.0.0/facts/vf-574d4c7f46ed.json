          "sk-018195aab1c0"
        ],
        "changeIds": [
          "chg-95162f889a56"
        ]
      }
    ],
    "candidates": [
      "sc-22716bcf1be8"
    ],
    "assertion": {
      "subject": {
        "family": "crd-field",
        "product": "argo-cd",
        "group": "argoproj.io",
        "kind": "Application",
        "path": "status.resources[].health"
      },
      "change": {
        "type": "behavior-changed"
      },
      "applicability": {
        "exposure": {
          "op": "all",
          "of": [
            {
              "op": "gvk-in-use",
              "group": "argoproj.io",
              "version": "v1alpha1",
              "kind": "Application"
            },
            {
              "op": "not",
              "of": [
                {
                  "op": "resource",
                  "of": [
                    {
                      "op": "field",
                      "path": "data[\"controller.resource.health.persist\"]",
                      "state": "set"
                    }
                  ],
                  "kind": "ConfigMap",
                  "name": "argocd-cmd-params-cm"
                }
              ]
            }
          ]
        },
        "overlap": {
          "op": "resource",
          "of": [
            {
              "op": "field",
              "path": "data[\"controller.resource.health.persist\"]",
              "state": "equals",
              "values": [
                "\"true\""
              ]
            }
          ],
          "kind": "ConfigMap",
          "name": "argocd-cmd-params-cm"
        }
      },
      "consequence": {
        "kind": "behavior-change",
        "exposedClass": "review-required",
        "statement": "Tools and CLI commands that parse `.status.resources[].health` directly will not find persisted health status; they must use the Argo CD CLI or API instead to retrieve health information.",
        "remediation": "Update any custom tooling or scripts parsing `.status.resources[].health` to use the Argo CD CLI or API for health status queries. Alternatively, set `controller.resource.health.persist: true` in the `argocd-cmd-params-cm.yaml` ConfigMap to restore the previous behavior.",
        "severity": "medium"
      },
      "statement": "Health status in the Application CR: The health status of each object used to be persisted under `/status` in the Application CR by default"
    },
    "verification": [
      {
        "aspect": "subject",
        "level": "deterministic",
