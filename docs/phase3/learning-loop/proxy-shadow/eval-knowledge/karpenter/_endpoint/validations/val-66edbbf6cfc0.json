        "path": "spec.metadataOptions.httpPutResponseHopLimit"
      },
      "change": {
        "type": "default-changed",
        "before": "2",
        "after": "1"
      },
      "applicability": {
        "exposure": {
          "op": "all",
          "of": [
            {
              "op": "gvk-in-use",
              "group": "karpenter.k8s.aws",
