            {
              "op": "field",
              "path": "spec.metadataOptions.httpPutResponseHopLimit",
              "state": "set"
            }
          ],
          "group": "karpenter.k8s.aws",
          "version": "v1beta1",
          "kind": "EC2NodeClass"
        }
      },
      "consequence": {
        "kind": "behavior-change",
        "exposedClass": "review-required",
        "statement": "EC2NodeClass resources that do not explicitly set spec.metadataOptions.httpPutResponseHopLimit will now use a default of 1 instead of 2, affecting the hop limit for EC2 instance metadata service responses.",
        "severity": "medium"
      },
      "statement": "The default value of spec.metadataOptions.httpPutResponseHopLimit in EC2NodeClass v1beta1 has changed from 2 to 1."
    },
