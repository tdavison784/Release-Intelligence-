    ],
    "assertion": {
      "subject": {
        "family": "crd-field",
        "product": "karpenter",
        "group": "karpenter.sh",
        "kind": "NodePool",
        "path": "spec.disruption.consolidationPolicy"
      },
      "change": {
        "type": "value-changed",
        "before": "\"WhenUnderutilized\"",
        "after": "\"WhenEmptyOrUnderutilized\""
      },
      "applicability": {
        "exposure": {
          "op": "resource",
          "of": [
            {
              "op": "field",
              "path": "spec.disruption.consolidationPolicy",
              "state": "equals",
              "values": [
                "\"WhenUnderutilized\""
              ]
            }
          ],
          "group": "karpenter.sh",
          "kind": "NodePool"
        }
      },
      "consequence": {
        "kind": "deprecation",
        "exposedClass": "review-required",
        "statement": "In Karpenter 1.0.0, NodePools applied with v1beta1 consolidationPolicy WhenUnderutilized are still converted to the v1 API by the conversion webhooks. Karpenter stops serving v1beta1 and drops the conversion webhooks at v1.1.0, so manifests still using the old v1beta1 form are expected to stop working then.",
        "remediation": "Migrate stored NodePool manifests to the v1 API, using consolidationPolicy WhenEmptyOrUnderutilized instead of WhenUnderutilized, before upgrading to Karpenter v1.1.0.",
        "severity": "medium"
      },
      "statement": "API Rename: NodePool’s ConsolidationPolicy `WhenUnderutilized` is now renamed to `WhenEmptyOrUnderutilized`"
    },
    "verification": [
