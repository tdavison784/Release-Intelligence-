    "original": {
      "applicability": {
        "exposure": {
          "op": "cli-flag",
          "name": "--providers.docker.swarmMode",
          "state": "set"
        }
      },
      "statement": "In v3 the Docker provider's swarmMode option is unsupported (Swarm moved to a separate Swarm provider), and configuring providers.docker.swarmMode prevents Traefik from starting."
    },
    "corrected": {
      "applicability": {
        "exposure": {
          "op": "any",
          "of": [
            {
              "op": "cli-flag",
              "name": "--providers.docker.swarmMode",
              "state": "set"
            },
            {
              "op": "resource",
              "of": [
                {
                  "op": "text-line",
                  "path": "data[\"traefik.yml\"]",
                  "state": "exists",
                  "pattern": "(?i)^\\s*swarmmode\\s*:"
                }
              ],
              "kind": "ConfigMap"
            },
            {
              "op": "resource",
              "of": [
                {
                  "op": "text-line",
                  "path": "data[\"traefik.yaml\"]",
                  "state": "exists",
                  "pattern": "(?i)^\\s*swarmmode\\s*:"
                }
              ],
              "kind": "ConfigMap"
            },
            {
              "op": "resource",
              "of": [
                {
                  "op": "text-line",
                  "path": "data[\"traefik.toml\"]",
                  "state": "exists",
                  "pattern": "(?i)^\\s*swarmmode\\s*="
                }
              ],
              "kind": "ConfigMap"
            }
          ]
        }
      },
      "statement": "In v3 the Docker provider no longer supports swarmMode (Swarm moved to a separate Swarm provider). Traefik fails to start when providers.docker.swarmMode is set, either as a CLI flag or in the static configuration file (YAML or TOML)."
    },
