      "statement": "HTTP/3 protocol support is moved from experimental to stable status and is no longer under an experimental designation."
    },
    "corrected": {
      "applicability": {
        "exposure": {
          "op": "any",
          "of": [
            {
              "op": "cli-flag",
              "name": "--experimental.http3",
              "state": "set"
            },
            {
              "op": "values-key",
              "path": "experimental.http3",
              "state": "set"
            }
          ]
        }
      },
      "statement": "HTTP/3 is no longer experimental in Traefik v3. The static option experimental.http3 is removed, and Traefik will not start if it is still set. Environments are exposed if they still set experimental.http3, either through the --experimental.http3 flag or in the experimental section of their configuration."
    },
