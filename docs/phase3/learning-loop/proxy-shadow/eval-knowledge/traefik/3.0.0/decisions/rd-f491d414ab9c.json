    "original": {
      "applicability": {
        "exposure": {
          "op": "all",
          "of": [
            {
              "op": "values-key",
              "path": "experimental.http3",
              "state": "set"
            },
            {
              "op": "edge-from-version",
              "state": "in-range",
              "range": "<3.0.0"
            }
          ]
        }
      },
      "statement": "The `experimental.http3` static configuration option is removed in Traefik v3.0.0; its presence prevents startup."
    },
    "corrected": {
      "applicability": {
        "exposure": {
          "op": "all",
          "of": [
            {
              "op": "any",
              "of": [
                {
                  "op": "cli-flag",
                  "name": "--experimental.http3",
                  "state": "set"
                },
                {
                  "op": "values-key",
                  "path": "experimental.http3",
                  "state": "set"
                }
              ]
            },
            {
              "op": "edge-from-version",
              "state": "in-range",
              "range": "<3.0.0"
            }
          ]
        }
      },
      "statement": "Environments upgrading from Traefik <3.0.0 are exposed if they still set the removed `experimental.http3` static option, either as the CLI flag `--experimental.http3` or as a values key. Traefik then fails to start."
    },
    "reviewer": "proxy:claude-opus-5-5",
    "reviewerKind": "proxy",
