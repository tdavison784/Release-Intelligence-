    "assertion": {
      "subject": {
        "family": "config-key",
        "product": "traefik",
        "path": "namespace",
        "component": "consulCatalog"
      },
      "change": {
        "type": "removed",
        "replacedBy": {
          "family": "config-key",
          "product": "traefik",
          "path": "namespaces",
          "component": "consulCatalog"
        }
      },
      "applicability": {
        "exposure": {
          "op": "any",
          "of": [
            {
              "op": "cli-flag",
              "name": "--consulCatalog.namespace",
              "state": "set"
            },
            {
              "op": "env-var",
              "name": "TRAEFIK_CONSULCATALOG_NAMESPACE",
              "state": "set"
            },
            {
              "op": "resource",
              "of": [
                {
                  "op": "text-line",
                  "path": "data[\"traefik.yml\"]",
                  "state": "exists",
                  "pattern": "^\\s*namespace\\s*:"
                }
              ],
              "kind": "ConfigMap"
            },
            {
              "op": "resource",
              "of": [
                {
                  "op": "text-line",
                  "path": "data[\"traefik.yaml\"]",
                  "state": "exists",
                  "pattern": "^\\s*namespace\\s*:"
                }
              ],
              "kind": "ConfigMap"
            },
            {
              "op": "resource",
              "of": [
                {
                  "op": "text-line",
                  "path": "data[\"traefik.toml\"]",
                  "state": "exists",
                  "pattern": "^\\s*namespace\\s*="
                }
              ],
              "kind": "ConfigMap"
            }
          ]
        }
      },
      "consequence": {
        "kind": "workload-failure",
        "exposedClass": "action-required",
        "statement": "The option is unsupported in v3 and would prevent Traefik from starting if still configured.",
        "remediation": "Replace the `namespace` option with the `namespaces` option.",
        "severity": "high"
      },
      "statement": "namespace: The ConsulCatalog provider `namespace` option was deprecated in v2 and is now removed in v3"
    },
