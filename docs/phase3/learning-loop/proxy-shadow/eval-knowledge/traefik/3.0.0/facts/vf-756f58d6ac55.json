    "assertion": {
      "subject": {
        "family": "config-key",
        "product": "traefik",
        "path": "experimental.http3"
      },
      "change": {
        "type": "removed"
      },
      "applicability": {
        "exposure": {
          "op": "any",
          "of": [
            {
              "op": "cli-flag",
              "name": "--experimental.http3",
              "state": "set"
            },
            {
              "op": "values-key",
              "path": "experimental.http3",
              "state": "set"
            }
          ]
        }
      },
      "consequence": {
        "kind": "upgrade-blocked",
        "exposedClass": "action-required",
        "statement": "If the static configuration still sets the removed `experimental.http3` option, Traefik v3 does not start: the option is now unsupported and would prevent Traefik from starting.",
        "remediation": "Remove the `http3` option from the experimental section of the static configuration. HTTP/3 can be enabled on entry points without it.",
        "severity": "high"
      },
      "statement": "[http3] Moves HTTP/3 outside the experimental section (#9570 by sdelicata)"
