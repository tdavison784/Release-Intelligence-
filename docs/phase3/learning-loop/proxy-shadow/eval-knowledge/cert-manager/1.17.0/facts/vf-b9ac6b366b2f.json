      "consequence": {
        "kind": "behavior-change",
        "exposedClass": "review-required",
        "statement": "Certificates signed by CA and SelfSigned issuers with RSA keys 3072 bits and above will now use SHA-384 or SHA-512 hash algorithms; downstream systems consuming these certificates must support these hash algorithms to avoid compatibility issues.",
        "remediation": "Verify that all systems relying on certificates from CA and SelfSigned issuers support SHA-384 and SHA-512 hash algorithms, especially if using RSA keys 3072 bits or larger.",
        "severity": "medium"
      },
      "statement": "Potentially BREAKING: The CA and SelfSigned issuers now use SHA-512 when signing with RSA keys 4096 bits and above, and SHA-384 when signing with RSA keys 3072…"
