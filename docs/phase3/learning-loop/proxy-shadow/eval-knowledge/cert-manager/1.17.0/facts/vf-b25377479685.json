      "change": {
        "type": "behavior-changed"
      },
      "applicability": {
        "exposure": {
          "op": "resource",
          "of": [
            {
              "op": "field",
              "path": "spec.privateKey.size",
              "state": "equals",
              "values": [
                "3072",
                "4096"
              ]
            }
          ],
          "group": "cert-manager.io",
          "kind": "Certificate"
        }
      },
      "consequence": {
        "kind": "behavior-change",
        "exposedClass": "review-required",
        "statement": "RSA certificates with 3072/4096-bit keys are signed with SHA-384/SHA-512 as they rotate; widely supported, but errors may appear with clients that don't support these hashes.",
        "severity": "low"
      },
      "statement": "RSA certificates with keys of length 3072 or 4096 will now use SHA-384 or SHA-512 respectively as hash algorithms"
    },
