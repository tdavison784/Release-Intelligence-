    "assertion": {
      "subject": {
        "family": "protocol-behavior",
        "product": "cert-manager",
        "name": "http01-ingress-pathtype"
      },
      "change": {
        "type": "behavior-changed",
        "after": "\"Exact\""
      },
      "applicability": {
        "exposure": {
          "op": "all",
          "of": [
            {
              "op": "any",
              "of": [
                {
                  "op": "resource",
                  "of": [
                    {
                      "op": "field",
                      "path": "spec.acme.solvers[].http01.ingress",
                      "state": "set"
                    }
                  ],
                  "group": "cert-manager.io",
                  "kind": "Issuer"
                },
                {
                  "op": "resource",
                  "of": [
                    {
                      "op": "field",
                      "path": "spec.acme.solvers[].http01.ingress",
                      "state": "set"
                    }
                  ],
                  "group": "cert-manager.io",
                  "kind": "ClusterIssuer"
                }
              ]
            },
            {
              "op": "product-version",
              "name": "ingress-nginx",
              "state": "in-range",
              "range": ">=1.8.0"
            },
            {
              "op": "not",
              "of": [
                {
                  "op": "resource",
                  "of": [
                    {
                      "op": "field",
                      "path": "data[\"strict-validate-path-type\"]",
                      "state": "equals",
                      "values": [
                        "\"false\""
                      ]
                    }
                  ],
                  "kind": "ConfigMap"
                }
              ]
            },
            {
              "op": "any",
              "of": [
                {
                  "op": "product-version",
                  "name": "ingress-nginx",
                  "state": "in-range",
                  "range": ">=1.12.0"
                },
                {
                  "op": "resource",
                  "of": [
                    {
                      "op": "field",
                      "path": "data[\"strict-validate-path-type\"]",
                      "state": "equals",
                      "values": [
                        "\"true\""
                      ]
                    }
                  ],
                  "kind": "ConfigMap"
                }
              ]
            }
          ]
        },
        "overlap": {
          "op": "all",
          "of": [
            {
              "op": "product-version",
              "name": "ingress-nginx",
              "state": "in-range",
              "range": ">=1.8.0"
            },
            {
              "op": "resource",
              "of": [
                {
                  "op": "field",
                  "path": "data[\"strict-validate-path-type\"]",
                  "state": "equals",
                  "values": [
                    "\"false\""
                  ]
                }
              ],
              "kind": "ConfigMap"
            }
          ]
        }
      },
      "consequence": {
        "kind": "workload-failure",
        "exposedClass": "action-required",
        "statement": "ACME HTTP01 challenges fail with admission webhook errors ('Error presenting challenge: admission webhook validate.nginx.ingress.kubernetes.io denied the request') in two cases: ingress-nginx >= 1.12.0 with the default strict-validate-path-type setting, or ingress-nginx >= 1.8.0 with that option enabled. The controller rejects the `/.well-known/acme-challenge/<TOKEN>` path because it contains a dot.",
        "remediation": "Disable the strict-validate-path-type configuration option in ingress-nginx, or solve HTTP01 challenges with a standards-compliant Ingress controller (e.g. Cilium) that handles PathType Exact.",
        "severity": "high"
      },
      "statement": "ACME HTTP01 challenge paths now use `PathType` `Exact` in Ingress routes: We have changed the `PathType` for ACME HTTP01 Ingress-based challenges to `Exact`.…"
    },
