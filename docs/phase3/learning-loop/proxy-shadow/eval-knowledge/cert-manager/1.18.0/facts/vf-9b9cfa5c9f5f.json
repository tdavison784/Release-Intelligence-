    "assertion": {
      "subject": {
        "family": "crd-field",
        "product": "cert-manager",
        "group": "cert-manager.io",
        "kind": "Certificate",
        "path": "spec.privateKey.rotationPolicy"
      },
      "change": {
        "type": "default-changed",
        "before": "\"Never\"",
        "after": "\"Always\""
      },
      "applicability": {
        "exposure": {
          "op": "resource",
          "of": [
            {
              "op": "field",
              "path": "spec.privateKey.rotationPolicy",
              "state": "unset"
            }
          ],
          "group": "cert-manager.io",
          "kind": "Certificate"
        },
        "overlap": {
          "op": "resource",
          "of": [
            {
              "op": "field",
              "path": "spec.privateKey.rotationPolicy",
              "state": "set"
            }
          ],
          "group": "cert-manager.io",
          "kind": "Certificate"
        }
      },
      "consequence": {
        "kind": "behavior-change",
        "exposedClass": "review-required",
        "statement": "Certificate resources that do not explicitly set spec.privateKey.rotationPolicy will now default to Always, so re-issuing a certificate (e.g. via `cmctl renew`) will generate a new private key where it previously reused the old one; the change still functions but with different semantics for every Certificate relying on the old default.",
        "remediation": "To preserve the old behavior, explicitly set `rotationPolicy: Never` on Certificate resources, or turn off the feature gate in this release and explicitly set `rotationPolicy: Never` on all Certificates before release 1.19 (in 1.19 the feature is GA and the gate can no longer be turned off).",
        "severity": "medium"
      },
      "statement": "We have changed the default value of `Certificate.Spec.PrivateKey.RotationPolicy` from `Never` to `Always`. > 📖 Read Release 1.18 notes for more information."
    },
