    "validator": "semvalidate.canonical@v1",
    "assertion": {
      "subject": {
        "family": "crd-field",
        "product": "cert-manager",
        "group": "cert-manager.io",
        "kind": "Certificate",
        "path": "spec.commonName"
      },
      "change": {
        "type": "behavior-changed",
        "before": "\"IP addresses in commonName added to the DNS subjectAlternativeName list\"",
        "after": "\"IP addresses in commonName added to the ipAddresses field\""
      },
      "applicability": {
        "exposure": {
          "op": "resource",
          "of": [
            {
              "op": "field",
              "path": "spec.commonName",
              "state": "matches",
              "pattern": "^(\\d{1,3}\\.){3}\\d{1,3}$|^[0-9a-fA-F:]*:[0-9a-fA-F:]*$"
            }
          ],
          "group": "cert-manager.io",
          "kind": "Certificate"
        }
      },
      "consequence": {
        "kind": "behavior-change",
        "exposedClass": "review-required",
        "statement": "For Certificates whose commonName is an IP address, the IP address is no longer added to the DNS subjectAlternativeName list. It is added to the ipAddresses field instead.",
        "remediation": "Check that any clients or validation that relied on the IP address being listed as a DNS SAN accept it as an IP SAN.",
        "severity": "low"
      },
      "statement": "In cert-manager 1.18.0, an IP address in a certificate's `commonName` is no longer added to the DNS `subjectAlternativeName` list. It is added to the `ipAddresses` field instead."
    },
    "checks": [
      {
        "aspect": "applicability",
        "outcome": "inconclusive",
        "rule": "canonical:crd-field/behavior-changed",
        "detail": "no canonical exposure condition for crd-field behavior-changed"
      }
