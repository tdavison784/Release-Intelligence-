    "assertion": {
      "subject": {
        "family": "gvk",
        "product": "external-secrets",
        "group": "external-secrets.io",
        "version": "v1beta1",
        "kind": "SecretStore"
      },
      "change": {
        "type": "behavior-changed",
        "before": "true",
        "after": "false"
      },
      "applicability": {
        "exposure": {
          "op": "all",
          "of": [
            {
              "op": "gvk-in-use",
              "group": "external-secrets.io",
              "kind": "SecretStore"
            },
            {
              "op": "edge-from-version",
              "state": "in-range",
              "range": "<0.16.0"
            }
          ]
        }
      },
      "consequence": {
        "kind": "behavior-change",
        "exposedClass": "review-required",
        "statement": "Nothing fails in this release. New or rewritten SecretStore objects are stored as v1, and existing objects stay stored as v1beta1 until rewritten. A storage version migration and a status.storedVersions update will be needed before any later release that removes v1beta1.",
        "remediation": "Optionally rewrite all SecretStore objects (storage version migration) and remove v1beta1 from status.storedVersions on the CRD before upgrading to a release that drops v1beta1.",
        "severity": "low"
      },
      "statement": "Storage version of `secretstores.external-secrets.io` changes v1beta1 → v1"
    },
    "verification": [
