    "assertion": {
      "subject": {
        "family": "migration",
        "product": "kyverno",
        "name": "updaterequests-storage-version-migration"
      },
      "change": {
        "type": "migration-required"
      },
      "applicability": {
        "exposure": {
          "op": "resource",
          "of": [
            {
              "op": "field",
              "path": "status.storedVersions[]",
              "state": "equals",
              "values": [
                "\"v1beta1\""
              ]
            }
          ],
          "group": "apiextensions.k8s.io",
          "kind": "CustomResourceDefinition",
          "name": "updaterequests.kyverno.io"
        }
      },
      "consequence": {
        "kind": "migration-required",
        "exposedClass": "action-required",
        "statement": "Existing UpdateRequest objects stay stored as v1beta1 until rewritten: the operator must run a storage version migration (re-write all objects) and update status.storedVersions before a later release removes v1beta1.",
        "remediation": "Run a storage version migration that re-writes all UpdateRequest objects so they are stored as v2, then update status.storedVersions of the updaterequests.kyverno.io CRD to remove v1beta1, before upgrading to a later release that removes v1beta1.",
        "severity": "medium"
      },
      "statement": "The storage version of the updaterequests.kyverno.io CRD changes from v1beta1 to v2 (v1beta1.storage true→false, v2.storage false→true between 1.12.6 and 1.13.0), so existing UpdateRequest objects stay stored as v1beta1 until a storage version migration re-writes them and status.storedVersions is updated, which must happen before a later release removes v1beta1."
    },
    "suggestedClass": "action-required",
