    "original": {
      "applicability": {
        "exposure": {
          "op": "resource",
          "of": [
            {
              "op": "any",
              "of": [
                {
                  "op": "field",
                  "path": "apiVersion",
                  "state": "equals",
                  "values": [
                    "\"kyverno.io/v2beta1\""
                  ]
                }
              ]
            }
          ],
          "group": "kyverno.io",
          "kind": "CleanupPolicy"
        }
      },
      "statement": "The storage version of cleanuppolicies.kyverno.io changes from v2beta1 to v2; existing objects remain stored as v2beta1 until rewritten via a storage version migration before v2beta1 is removed."
    },
    "corrected": {
      "applicability": {
        "exposure": {
          "op": "all",
          "of": [
            {
              "op": "gvk-in-use",
              "group": "kyverno.io",
              "kind": "CleanupPolicy"
            },
            {
              "op": "edge-from-version",
              "state": "in-range",
              "range": "<1.13.0"
            }
          ]
        }
      },
      "statement": "Environments that have kyverno.io CleanupPolicy objects (any apiVersion) and upgrade from a release before 1.13.0 are exposed: those objects stay stored as v2beta1 after v2 becomes the storage version, until they are rewritten and status.storedVersions is updated."
    },
