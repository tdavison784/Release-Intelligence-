    "assertion": {
      "subject": {
        "family": "cli-flag",
        "product": "kyverno",
        "name": "--enableReporting"
      },
      "change": {
        "type": "added",
        "after": "\"validate,mutate,mutateExisting,imageVerify,generate\""
      },
      "applicability": {
        "exposure": {
          "op": "all",
          "of": [
            {
              "op": "any",
              "of": [
                {
                  "op": "resource",
                  "of": [
                    {
                      "op": "field",
                      "path": "spec.rules[].mutate",
                      "state": "set"
                    }
                  ],
                  "group": "kyverno.io",
                  "kind": "ClusterPolicy"
                },
                {
                  "op": "resource",
                  "of": [
                    {
                      "op": "field",
                      "path": "spec.rules[].generate",
                      "state": "set"
                    }
                  ],
                  "group": "kyverno.io",
                  "kind": "ClusterPolicy"
                },
                {
                  "op": "resource",
                  "of": [
                    {
                      "op": "field",
                      "path": "spec.rules[].mutate",
                      "state": "set"
                    }
                  ],
                  "group": "kyverno.io",
                  "kind": "Policy"
                },
                {
                  "op": "resource",
                  "of": [
                    {
                      "op": "field",
                      "path": "spec.rules[].generate",
                      "state": "set"
                    }
                  ],
                  "group": "kyverno.io",
                  "kind": "Policy"
                }
              ]
            },
            {
              "op": "cli-flag",
              "name": "--enableReporting",
              "state": "has-token",
              "values": [
                "mutate",
                "mutateExisting",
                "generate"
              ]
            }
          ]
        }
      },
      "consequence": {
        "kind": "behavior-change",
        "exposedClass": "review-required",
        "statement": "After the upgrade, policy reports also record results for mutate, mutateExisting and generate rules, because the chart default enables reporting for validate, mutate, mutateExisting, imageVerify and generate. If the reports controller has not been granted the permissions it needs, a warning message is returned when a policy is admitted. The evidence does not say that anything fails.",
        "remediation": "Grant the reports controller the RBAC permissions it needs for the new report types, or set --enableReporting to only the rule types you want reported.",
        "severity": "low"
      },
      "statement": "Reports for Mutate and Generate rules: In addition to validate and verifyImages rules, Kyverno 1.13 supports reporting for generate and mutate, including…"
    },
