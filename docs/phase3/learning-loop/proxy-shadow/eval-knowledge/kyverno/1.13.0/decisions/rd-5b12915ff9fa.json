    "action": "correct",
    "labels": [
      "corrected",
      "wrong-applicability"
    ],
    "original": {
      "applicability": {
        "exposure": {
          "op": "gvk-in-use",
          "group": "kyverno.io",
          "kind": "PolicyException"
        }
      },
      "statement": "In Kyverno 1.13.0 the Helm chart's default exception settings change: the chart values of prior versions enabled policy exceptions by default for all namespaces, which created a potential security issue (CVE-2024-48921), and users who relied on policy exceptions being enabled in all namespaces are impacted."
    },
    "corrected": {
      "applicability": {
        "exposure": {
          "op": "all",
          "of": [
            {
              "op": "gvk-in-use",
              "group": "kyverno.io",
              "kind": "PolicyException"
            },
            {
              "op": "values-key",
              "path": "features.policyExceptions.namespace",
              "state": "unset"
            }
          ]
        },
        "overlap": {
          "op": "values-key",
          "path": "features.policyExceptions.namespace",
          "state": "set"
        }
      },
      "statement": "In Kyverno 1.13.0 the Helm chart no longer enables policy exceptions in all namespaces by default (CVE-2024-48921). Environments that use PolicyExceptions without setting features.policyExceptions.namespace are affected; setting it to '*' keeps the previous behaviour."
    },
    "reviewer": "proxy:claude-opus-5-5",
