  "validation": {
    "id": "val-f9ba5a79652d",
    "candidateId": "sc-194c2ca12ce9",
    "proposalId": "sp-92ea22832e40",
    "validator": "render.rendered-diff@v1",
    "assertion": {
      "subject": {
        "family": "cli-flag",
        "product": "kyverno",
        "name": "--enablePolicyException"
      },
      "change": {
        "type": "default-changed",
        "before": "true",
        "after": "false"
      },
      "applicability": {
        "exposure": {
          "op": "all",
          "of": [
            {
              "op": "gvk-in-use",
              "group": "kyverno.io",
              "kind": "PolicyException"
            },
            {
              "op": "cli-flag",
              "name": "--enablePolicyException",
              "state": "unset"
            }
          ]
        },
        "overlap": {
          "op": "cli-flag",
          "name": "--enablePolicyException",
          "state": "set"
        }
      },
      "consequence": {
        "kind": "setting-ignored",
        "exposedClass": "action-required",
        "statement": "After upgrading to 1.13, policy exceptions are disabled by default and only allowed in a specified namespace, so environments that relied on the prior default (exceptions allowed in all namespaces) have their existing PolicyException resources no longer honoured and previously-excepted resources become subject to policy enforcement again unless the operator follows the upgrade guidance.",
        "remediation": "Follow the Kyverno 1.13 upgrade guidance to explicitly re-enable policy exceptions, now restricted to a specified namespace, instead of relying on the previous defaults.",
        "severity": "high"
      },
      "statement": "Kyverno 1.13 changes the defaults so that policy exceptions are disabled and only allowed in a specified namespace (previously allowed in all namespaces, see CVE-2024-48921); environments relying on the old default must follow the upgrade guidance to keep exceptions working."
    },
    "checks": [
      {
        "aspect": "subject",
        "outcome": "confirmed",
        "rule": "rendered-diff:cli-flag/default-changed",
        "detail": "cli-flag:kyverno|name=--enablePolicyException: source render 3× [true], target render 3× [false]"
      },
      {
        "aspect": "change",
        "outcome": "confirmed",
        "rule": "rendered-diff:cli-flag/default-changed",
        "detail": "cli-flag:kyverno|name=--enablePolicyException: source render 3× [true], target render 3× [false]"
      }
    ],
