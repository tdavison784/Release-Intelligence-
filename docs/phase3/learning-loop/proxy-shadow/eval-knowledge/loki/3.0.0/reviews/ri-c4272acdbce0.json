  "reviewItem": {
    "id": "ri-c4272acdbce0",
    "candidateId": "sc-3b226877c4f2",
    "product": "loki",
    "release": "3.0.0",
    "questionType": "applicability",
    "question": "For \"Structured Metadata, Open Telemetry, Schemas and Indexes: A flagship feature of Loki 3.0 is native support for the Open Telemetry Protocol (OTLP)\", which environments are exposed? Confirm or correct the exposure condition.",
    "proposed": {
      "applicability": {
        "exposure": {
          "op": "all",
          "of": [
            {
              "op": "product-version",
              "name": "loki",
              "state": "in-range",
              "range": ">=3.0.0"
            },
            {
              "op": "any",
              "of": [
                {
                  "op": "not",
                  "of": [
                    {
                      "op": "values-key",
                      "path": "schemaConfig.schema",
                      "state": "matches",
                      "pattern": ".*tsdb.*"
                    }
                  ]
                },
                {
                  "op": "not",
                  "of": [
                    {
                      "op": "values-key",
                      "path": "schemaConfig.schemaVersion",
                      "state": "equals",
                      "values": [
                        "\"v13\""
                      ]
                    }
                  ]
                }
              ]
            }
          ]
        }
      },
      "statement": "Structured Metadata is enabled by default in Loki 3.0 and requires both tsdb index type and v13 storage schema to function."
    },
    "proposals": [
      "sp-9194d05e9a10",
      "sp-e1a4c6192690"
    ],
