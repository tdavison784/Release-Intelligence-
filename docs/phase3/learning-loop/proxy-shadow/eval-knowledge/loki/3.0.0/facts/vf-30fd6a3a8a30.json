      "consequence": {
        "kind": "behavior-change",
        "exposedClass": "review-required",
        "statement": "Metrics emitted by Loki will use the 'loki' namespace by default instead of 'cortex', changing the metric namespace prefix unless explicitly configured otherwise.",
        "remediation": "Verify that metric scrape configurations, dashboards, and alerting rules that reference metrics with the 'cortex' namespace are updated to use the 'loki' namespace, or explicitly set --metrics-namespace=cortex to retain the previous behavior.",
        "severity": "medium"
      },
      "statement": "loki: Add the `metrics-namespace` flag to change the namespace of metrics currently using cortex as namespace"
