        "name": "--boltdb.shipper.compactor.shared-store",
        "component": "compactor"
      },
      "change": {
        "type": "removed"
      },
      "applicability": {
        "exposure": {
          "op": "cli-flag",
          "name": "-boltdb.shipper.compactor.shared-store",
          "state": "set"
        }
      },
      "consequence": {
        "kind": "setting-ignored",
        "exposedClass": "action-required",
        "statement": "The `-boltdb.shipper.compactor.shared-store` flag and its YAML setting are removed, so a configured value no longer selects the compactor's shared store. The compactor now runs compaction and retention on all object stores configured in period configs where the index type is tsdb or boltdb-shipper.",
        "remediation": "Remove `-boltdb.shipper.compactor.shared-store` and the matching YAML `shared_store` setting from the compactor configuration. Check that the period configs list the object stores that should be compacted and have retention applied.",
        "severity": "medium"
      },
      "statement": "`-boltdb.shipper.compactor.shared-store`"
    },
