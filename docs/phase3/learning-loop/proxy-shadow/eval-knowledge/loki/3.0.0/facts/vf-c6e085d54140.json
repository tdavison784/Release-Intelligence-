    "assertion": {
      "subject": {
        "family": "cli-flag",
        "product": "loki",
        "name": "-boltdb.shipper.shared-store.key-prefix"
      },
      "change": {
        "type": "removed"
      },
      "applicability": {
        "exposure": {
          "op": "any",
          "of": [
            {
              "op": "cli-flag",
              "name": "-boltdb.shipper.shared-store.key-prefix",
              "state": "set"
            },
            {
              "op": "resource",
              "of": [
                {
                  "op": "text-line",
                  "path": "data[\"config.yaml\"]",
                  "state": "exists",
                  "pattern": "^\\s*shared_store_key_prefix\\s*:"
                }
              ],
              "kind": "ConfigMap"
            }
          ]
        }
      },
      "consequence": {
        "kind": "setting-ignored",
        "exposedClass": "action-required",
        "statement": "Loki 3.0.0 removes `-boltdb.shipper.shared-store.key-prefix` and its YAML setting. The index path prefix is now set with `path_prefix` under the period config's `index` key, so a key prefix configured through the removed setting is no longer honoured. This affects you if you set it to a value other than `index/`.",
        "remediation": "Remove the deleted flag/YAML setting. If it was set to a value other than `index/`, set `path_prefix` in every existing period config that uses `boltdb-shipper` as the index to the value you configured before.",
        "severity": "high"
      },
      "statement": "`-boltdb.shipper.shared-store.key-prefix`"
    },
