    "assertion": {
      "subject": {
        "family": "cli-flag",
        "product": "loki",
        "name": "-boltdb.shipper.compactor.shared-store.key-prefix",
        "component": "compactor"
      },
      "change": {
        "type": "removed"
      },
      "applicability": {
        "exposure": {
          "op": "cli-flag",
          "name": "-boltdb.shipper.compactor.shared-store.key-prefix",
          "state": "set"
        }
      },
      "consequence": {
        "kind": "setting-ignored",
        "exposedClass": "action-required",
        "statement": "The `-boltdb.shipper.compactor.shared-store.key-prefix` CLI flag and its matching YAML setting are removed in Loki 3.0.0, so a configured key prefix no longer controls compactor behaviour. The compactor instead runs compaction and retention on all object stores configured in period configs where the index type is tsdb or boltdb-shipper.",
        "remediation": "Remove the flag and its YAML setting from the compactor configuration. Check that the object stores in your period configs (tsdb/boltdb-shipper index types) are the ones the compactor should compact and apply retention to.",
        "severity": "medium"
      },
      "statement": "`-boltdb.shipper.compactor.shared-store.key-prefix`"
    },
