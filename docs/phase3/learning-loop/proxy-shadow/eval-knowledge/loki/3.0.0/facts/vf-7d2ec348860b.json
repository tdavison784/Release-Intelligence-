    ],
    "assertion": {
      "subject": {
        "family": "config-key",
        "product": "loki",
        "path": "shared_store"
      },
      "change": {
        "type": "removed"
      },
      "applicability": {
        "exposure": {
          "op": "any",
          "of": [
            {
              "op": "resource",
              "of": [
                {
                  "op": "text-line",
                  "path": "data[\"config.yaml\"]",
                  "state": "exists",
                  "pattern": "^\\s*shared_store\\s*:"
                }
              ],
              "kind": "ConfigMap"
            },
            {
              "op": "cli-flag",
              "name": "-boltdb.shipper.shared-store",
              "state": "set"
            },
            {
              "op": "cli-flag",
              "name": "-tsdb.shipper.shared-store",
              "state": "set"
            }
          ]
        }
      },
      "consequence": {
        "kind": "setting-ignored",
        "exposedClass": "action-required",
        "statement": "The `shared_store` value is no longer honoured, and `object_store` in `period_config` decides where the index is stored. If the old value matched `object_store` for every period, only the deleted option needs removing. If it did not match, you lose access to the index for those periods, so they cannot be queried.",
        "remediation": "Remove the deleted `shared_store` option from your configuration. For any period where it did not match `object_store`, move or copy the index tables to the store set in `object_store` so the index can be queried again.",
        "severity": "high"
      },
      "statement": "The `shared_store` config is removed"
    },
