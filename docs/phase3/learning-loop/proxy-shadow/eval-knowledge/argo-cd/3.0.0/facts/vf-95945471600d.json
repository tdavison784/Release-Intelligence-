    "assertion": {
      "subject": {
        "family": "config-key",
        "product": "argo-cd",
        "path": "server.rbac.disableApplicationFineGrainedRBACInheritance",
        "component": "argocd-cm"
      },
      "change": {
        "type": "behavior-changed",
        "before": "\"policies granting `update` or `delete` to an application also applied to any of its sub-resources\"",
        "after": "\"the `update` or `delete` actions only apply to the application itself\""
      },
      "applicability": {
        "exposure": {
          "op": "all",
          "of": [
            {
              "op": "any",
              "of": [
                {
                  "op": "resource",
                  "of": [
                    {
                      "op": "text-line",
                      "path": "data[\"policy.csv\"]",
                      "state": "exists",
                      "pattern": "^\\s*p\\s*,[^,]*,\\s*applications\\s*,\\s*(update|delete)\\s*,"
                    }
                  ],
                  "kind": "ConfigMap",
                  "name": "argocd-rbac-cm"
                },
                {
                  "op": "resource",
                  "of": [
                    {
                      "op": "field",
                      "path": "spec.roles[].policies[]",
                      "state": "matches",
                      "pattern": ",\\s*applications\\s*,\\s*(update|delete)\\s*,"
                    }
                  ],
                  "group": "argoproj.io",
                  "kind": "AppProject"
                }
              ]
            },
            {
              "op": "not",
              "of": [
                {
                  "op": "resource",
                  "of": [
                    {
                      "op": "field",
                      "path": "data[\"server.rbac.disableApplicationFineGrainedRBACInheritance\"]",
                      "state": "equals",
                      "values": [
                        "\"false\""
                      ]
                    }
                  ],
                  "kind": "ConfigMap",
                  "name": "argocd-cm"
                }
              ]
            }
          ]
        },
        "overlap": {
          "op": "resource",
          "of": [
            {
              "op": "field",
              "path": "data[\"server.rbac.disableApplicationFineGrainedRBACInheritance\"]",
              "state": "equals",
              "values": [
                "\"false\""
              ]
            }
          ],
          "kind": "ConfigMap",
          "name": "argocd-cm"
        }
      },
      "consequence": {
        "kind": "permission-lost",
        "exposedClass": "action-required",
        "statement": "RBAC policies granting update or delete permissions on Applications no longer automatically grant those permissions on managed sub-resources; operators must define separate policies with update/* or delete/* verbs to maintain access to application-managed resources.",
        "remediation": "Define new RBAC policies with update/* and delete/* verbs for managed resources, or set server.rbac.disableApplicationFineGrainedRBACInheritance to false in argocd-cm to preserve v2 behavior.",
        "severity": "high"
      },
      "statement": "Fine-Grained RBAC for application `update` and `delete` sub-resources: The default behavior of fine-grained policies have changed so they no longer apply to…"
