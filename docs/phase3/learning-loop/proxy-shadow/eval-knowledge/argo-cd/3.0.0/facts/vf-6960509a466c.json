    ],
    "assertion": {
      "subject": {
        "family": "config-key",
        "product": "argo-cd",
        "path": "server.rbac.log.enforce.enable",
        "component": "argocd-cm"
      },
      "change": {
        "type": "removed"
      },
      "applicability": {
        "exposure": {
          "op": "all",
          "of": [
            {
              "op": "values-key",
              "path": "configs.rbac[\"policy.default\"]",
              "state": "unset"
            },
            {
              "op": "any",
              "of": [
                {
                  "op": "values-key",
                  "path": "configs.cm[\"server.rbac.log.enforce.enable\"]",
                  "state": "unset"
                },
                {
                  "op": "values-key",
                  "path": "configs.cm[\"server.rbac.log.enforce.enable\"]",
                  "state": "equals",
                  "values": [
                    "\"false\""
                  ]
                }
              ]
            }
          ]
        },
        "overlap": {
          "op": "any",
          "of": [
            {
              "op": "values-key",
              "path": "configs.cm[\"server.rbac.log.enforce.enable\"]",
              "state": "equals",
              "values": [
                "\"true\""
              ]
            },
            {
              "op": "values-key",
              "path": "configs.rbac[\"policy.default\"]",
              "state": "matches",
              "pattern": "^role:(readonly|admin)$"
            }
          ]
        }
      },
      "consequence": {
        "kind": "permission-lost",
        "exposedClass": "action-required",
        "statement": "Users, groups and roles that relied on `applications, get` for implicit logs access lose it. The `logs` tab on pod view is not visible to them unless they are granted explicit `logs, get` permission.",
        "remediation": "Grant explicit `logs, get` permissions to the users/groups/roles that need log access. After the upgrade, remove server.rbac.log.enforce.enable from argocd-cm if it was set.",
        "severity": "medium"
      },
      "statement": "Logs RBAC enforcement as a first-class RBAC citizen: 2.4 introduced `logs` as a new RBAC resource"
    },
