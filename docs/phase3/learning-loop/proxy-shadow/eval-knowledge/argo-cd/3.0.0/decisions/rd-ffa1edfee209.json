            {
              "op": "any",
              "of": [
                {
                  "op": "field",
                  "path": "data.repositories",
                  "state": "set"
                },
                {
                  "op": "field",
                  "path": "data[\"repository.credentials\"]",
                  "state": "set"
                },
                {
                  "op": "field",
                  "path": "data[\"helm.repositories\"]",
                  "state": "set"
                }
              ]
            }
          ],
          "kind": "ConfigMap",
          "name": "argocd-cm"
        }
      },
      "statement": "Argo CD 3.0 removes legacy repository configuration in the argocd-cm ConfigMap. An environment is exposed if argocd-cm sets any of data.repositories, data[\"repository.credentials\"] or data[\"helm.repositories\"]."
    },
