      },
      "statement": "Starting from Argo CD 3.0, logs RBAC enforcement is enabled by default; the `server.rbac.log.enforce.enable` flag is removed from `argocd-cm` ConfigMap and users no longer automatically get logs access through `applications, get` permissions alone."
    },
    "corrected": {
      "applicability": {
        "exposure": {
          "op": "all",
          "of": [
            {
              "op": "values-key",
              "path": "configs.rbac[\"policy.default\"]",
              "state": "unset"
            },
            {
              "op": "any",
              "of": [
                {
                  "op": "values-key",
                  "path": "configs.cm[\"server.rbac.log.enforce.enable\"]",
                  "state": "unset"
                },
                {
                  "op": "values-key",
                  "path": "configs.cm[\"server.rbac.log.enforce.enable\"]",
                  "state": "equals",
                  "values": [
                    "\"false\""
                  ]
                }
              ]
            }
          ]
        },
        "overlap": {
          "op": "any",
          "of": [
            {
              "op": "values-key",
              "path": "configs.cm[\"server.rbac.log.enforce.enable\"]",
              "state": "equals",
              "values": [
                "\"true\""
              ]
            },
            {
              "op": "values-key",
              "path": "configs.rbac[\"policy.default\"]",
              "state": "matches",
              "pattern": "^role:(readonly|admin)$"
            }
          ]
        }
      },
      "statement": "Exposed: environments with no policy.default in argocd-rbac-cm whose argocd-cm leaves server.rbac.log.enforce.enable unset or sets it to \"false\". Shielded: environments that set the flag to \"true\", or set policy.default to role:readonly or role:admin."
    },
