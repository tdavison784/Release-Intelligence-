      "statement": "Local Redirect Policy with socket-based load-balancing now redirects traffic from node-local backends destined to the policy's frontend back to the node-local backends by default; set skipRedirectFromBackend to true to override this."
    },
    "corrected": {
      "applicability": {
        "exposure": {
          "op": "all",
          "of": [
            {
              "op": "resource",
              "of": [
                {
                  "op": "field",
                  "path": "spec.skipRedirectFromBackend",
                  "state": "unset"
                }
              ],
              "group": "cilium.io",
              "version": "v2",
              "kind": "CiliumLocalRedirectPolicy"
            },
            {
              "op": "undecidable",
              "reason": "evidence-gap",
              "needed": "whether socket-based load-balancing is enabled together with Local Redirect Policy (the evidence does not name the configuration key)"
            }
          ]
        },
        "overlap": {
          "op": "resource",
          "of": [
            {
              "op": "field",
              "path": "spec.skipRedirectFromBackend",
              "state": "equals",
              "values": [
                "true"
              ]
            }
          ],
          "group": "cilium.io",
          "version": "v2",
          "kind": "CiliumLocalRedirectPolicy"
        }
      },
      "statement": "Environments are exposed when they have a cilium.io/v2 CiliumLocalRedirectPolicy without spec.skipRedirectFromBackend set and socket-based load-balancing is enabled. In that case, traffic from the policy-selected node-local backends to the policy's frontend is now redirected back to the node-local backends by default. Policies that set skipRedirectFromBackend to true are shielded."
    },
