    "assertion": {
      "subject": {
        "family": "protocol-behavior",
        "product": "cilium",
        "name": "tofqdns-policy-implementation"
      },
      "change": {
        "type": "behavior-changed",
        "before": "\"creating `cidr` identities for each allowed IP\"",
        "after": "\"IPs observed in DNS lookups are now labeled with the selectors `toFQDNs` matching them\""
      },
      "applicability": {
        "exposure": {
          "op": "all",
          "of": [
            {
              "op": "edge-from-version",
              "state": "in-range",
              "range": "<1.15.6"
            },
            {
              "op": "any",
              "of": [
                {
                  "op": "resource",
                  "of": [
                    {
                      "op": "field",
                      "path": "spec.egress[].toFQDNs[]",
                      "state": "set"
                    }
                  ],
                  "group": "cilium.io",
                  "kind": "CiliumNetworkPolicy"
                },
                {
                  "op": "resource",
                  "of": [
                    {
                      "op": "field",
                      "path": "spec.egress[].toFQDNs[]",
                      "state": "set"
                    }
                  ],
                  "group": "cilium.io",
                  "kind": "CiliumClusterwideNetworkPolicy"
                }
              ]
            }
          ]
        },
        "overlap": {
          "op": "all",
          "of": [
            {
              "op": "edge-from-version",
              "state": "out-of-range",
              "range": "<1.15.6"
            },
            {
              "op": "any",
              "of": [
                {
                  "op": "resource",
                  "of": [
                    {
                      "op": "field",
                      "path": "spec.egress[].toFQDNs[]",
                      "state": "set"
                    }
                  ],
                  "group": "cilium.io",
                  "kind": "CiliumNetworkPolicy"
                },
                {
                  "op": "resource",
                  "of": [
                    {
                      "op": "field",
                      "path": "spec.egress[].toFQDNs[]",
                      "state": "set"
                    }
                  ],
                  "group": "cilium.io",
                  "kind": "CiliumClusterwideNetworkPolicy"
                }
              ]
            }
          ]
        }
      },
      "consequence": {
        "kind": "workload-failure",
        "exposedClass": "action-required",
        "statement": "Temporary packet drops may occur for connections allowed by toFQDNs policies during the initial endpoint regeneration on Cilium v1.16 when upgrading from a version older than v1.15.6.",
        "remediation": "Upgrade to Cilium v1.15.6 or newer before upgrading to v1.16.",
        "severity": "medium"
      },
      "statement": "The implementation of `toFQDNs` selectors in policies has been overhauled to improve performance when many different IPs are observed for a selector: Instead…"
