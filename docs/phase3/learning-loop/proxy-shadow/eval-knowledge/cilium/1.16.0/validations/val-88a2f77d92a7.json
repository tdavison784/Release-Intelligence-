    "validator": "semvalidate.values@v1",
    "assertion": {
      "subject": {
        "family": "helm-value",
        "product": "cilium",
        "path": "bpf.enableTCX"
      },
      "change": {
        "type": "behavior-changed",
        "before": "\"old-style tc BPF attachment mode\"",
        "after": "\"tcx BPF links\""
      },
      "applicability": {
        "exposure": {
          "op": "all",
          "of": [
            {
              "op": "cluster-version",
              "name": "linux-kernel",
              "state": "in-range",
              "range": ">=6.6.0"
            },
            {
              "op": "not",
              "of": [
                {
                  "op": "values-key",
                  "path": "bpf.enableTCX",
                  "state": "equals",
                  "values": [
                    "false"
                  ]
                }
              ]
            }
          ]
        },
        "overlap": {
          "op": "values-key",
          "path": "bpf.enableTCX",
          "state": "equals",
          "values": [
            "false"
          ]
        }
      },
      "consequence": {
        "kind": "behavior-change",
        "exposedClass": "review-required",
        "statement": "On nodes with Linux kernel 6.6 or newer, Cilium attaches its tc BPF programs in the core datapath using tcx BPF links instead of old-style tc BPF attachment; setups with third-party old-style tc BPF users should disable this via the Helm value bpf.enableTCX=false in order to continue in old-style tc BPF attachment mode as before.",
        "remediation": "Set the Helm value bpf.enableTCX=false to continue in old-style tc BPF attachment mode when third-party old-style tc BPF users are present.",
        "severity": "medium"
      },
      "statement": "For Linux kernels 6.6 or newer, Cilium 1.16 by default attaches its tc BPF programs in the core datapath using tcx BPF links instead of old-style tc BPF attachment, controlled by the Helm value bpf.enableTCX, which should be set to false when third-party old-style tc BPF users are present."
    },
    "checks": [
      {
        "aspect": "subject",
        "outcome": "confirmed",
        "rule": "helm-values:exists",
        "detail": "bpf.enableTCX is a values key in the target release only of chart cilium"
      },
      {
        "aspect": "change",
        "outcome": "inconclusive",
        "rule": "helm-values:behavior-changed",
        "detail": "a behavior-changed change is not decidable from values snapshots"
