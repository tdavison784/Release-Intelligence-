    "assertion": {
      "subject": {
        "family": "protocol-behavior",
        "product": "cilium",
        "name": "mtu-auto-detection"
      },
      "change": {
        "type": "behavior-changed",
        "before": "\"only the primary interface was considered\"",
        "after": "\"the lowest MTU of all external interfaces\""
      },
      "applicability": {
        "exposure": {
          "op": "all",
          "of": [
            {
              "op": "values-key",
              "path": "MTU",
              "state": "unset"
            },
            {
              "op": "cli-flag",
              "name": "--mtu",
              "state": "unset"
            },
            {
              "op": "undecidable",
              "reason": "environment-visibility-gap",
              "needed": "whether nodes have more than one external interface where a non-primary interface (excluding ENI secondary interfaces in ENI mode) has a lower MTU than the primary interface, and whether the CNI configuration sets the mtu option"
            }
          ]
        },
        "overlap": {
          "op": "any",
          "of": [
            {
              "op": "values-key",
              "path": "MTU",
              "state": "set"
            },
            {
              "op": "cli-flag",
              "name": "--mtu",
              "state": "set"
            }
          ]
        }
      },
      "consequence": {
        "kind": "behavior-change",
        "exposedClass": "review-required",
        "statement": "Environments using auto-detection will now select the lowest MTU across all external interfaces instead of only the primary interface, which may result in lower MTU values being applied.",
        "remediation": "If the change in MTU value is not desired, configure MTU manually via the MTU helm option, --mtu agent flag, or mtu option in CNI configuration.",
        "severity": "medium"
      },
      "statement": "MTU auto-detection will now use the lowest MTU of all external interfaces"
    },
