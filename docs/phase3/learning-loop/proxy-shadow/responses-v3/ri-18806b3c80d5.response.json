      "wrong-applicability"
    ],
    "correction": {
      "statement": "Clusters upgrading to Cilium 1.16 from a version below 1.15.6 that have toFQDNs rules in a CiliumNetworkPolicy or CiliumClusterwideNetworkPolicy may see brief packet drops for connections allowed by those rules during the first endpoint regeneration. Clusters already on v1.15.6 or newer are shielded.",
      "applicability": {
        "determination": "asserted",
        "exposure": {
          "op": "all",
          "of": [
            {
              "op": "edge-from-version",
              "state": "in-range",
              "range": "<1.15.6"
            },
            {
              "op": "any",
              "of": [
                {
