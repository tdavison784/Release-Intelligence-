  "output": {
    "action": "correct",
    "reason": "[ev-110340e9c914] says the breakage needs ingress-nginx >=1.8.0 with the strict-validate-path-type option on, and that the option is on by default from 1.12.0. The proposed condition flags every Ingress user rather than only HTTP01 Ingress solvers. It also flags every ingress-nginx >=1.12.0 install, even one that turned the option off. It treats a named configuration option as runtime behaviour (undecidable), when a predicate should read it. The corrected condition requires an HTTP01 Ingress solver, ingress-nginx >=1.8.0, no explicit \"false\", and either >=1.12.0 or an explicit \"true\". The field and ConfigMap locations are not stated in the evidence, so confidence is low.",
    "citations": [
      "ev-110340e9c914"
    ],
    "confidence": "low",
    "labels": [
      "wrong-applicability"
    ],
    "correction": {
      "statement": "Exposed: environments where an ACME Issuer/ClusterIssuer uses an HTTP01 Ingress solver, ingress-nginx is >=1.8.0, strict-validate-path-type is not explicitly false, and either ingress-nginx is >=1.12.0 (on by default) or the option is explicitly true. Their challenge Ingress with PathType Exact is denied by the ingress-nginx admission webhook.",
      "applicability": {
        "determination": "asserted",
        "exposure": {
          "op": "all",
          "of": [
            {
              "op": "any",
              "of": [
                {
                  "op": "resource",
                  "group": "cert-manager.io",
                  "kind": "Issuer",
                  "of": [
                    {
                      "op": "field",
                      "path": "spec.acme.solvers[].http01.ingress",
                      "state": "set"
                    }
                  ]
                },
                {
                  "op": "resource",
                  "group": "cert-manager.io",
                  "kind": "ClusterIssuer",
                  "of": [
                    {
                      "op": "field",
                      "path": "spec.acme.solvers[].http01.ingress",
                      "state": "set"
                    }
                  ]
                }
              ]
            },
            {
              "op": "product-version",
              "name": "ingress-nginx",
              "state": "in-range",
              "range": ">=1.8.0"
            },
            {
              "op": "not",
              "of": [
                {
                  "op": "resource",
                  "kind": "ConfigMap",
                  "of": [
                    {
                      "op": "field",
                      "path": "data[\"strict-validate-path-type\"]",
                      "state": "equals",
                      "values": [
