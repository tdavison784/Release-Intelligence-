                      ]
                    }
                  ]
                }
              ]
            },
            {
              "op": "any",
              "of": [
                {
                  "op": "product-version",
                  "name": "ingress-nginx",
                  "state": "in-range",
                  "range": ">=1.12.0"
                },
                {
                  "op": "resource",
                  "kind": "ConfigMap",
                  "of": [
                    {
                      "op": "field",
