  "output": {
    "action": "correct",
    "reason": "[ev-5dacaee98643] and [ev-8b7267b73a1c] say Loki 3.0 won't start when structured metadata is on (the default) and the active schema isn't both the `tsdb` index and the `v13` schema. [ev-649f409b4be1] says operators can avoid this by setting `allow_structured_metadata: false` in limits_config or `-validation.allow-structured-metadata=false`. The proposed exposure ignores that opt-out, so it flags environments that are actually safe. Its bare \\btsdb\\b pattern also matches unrelated keys such as tsdb_shipper, so the correction matches the `store:` and `schema:` lines instead.",
    "citations": [
      "ev-5dacaee98643",
      "ev-8b7267b73a1c",
      "ev-649f409b4be1",
      "ev-7791a108cc39"
    ],
    "confidence": "low",
    "labels": [
      "wrong-applicability"
    ],
    "correction": {
      "statement": "Loki 3.0.0 enables structured metadata by default. It requires the active schema to use the tsdb index and the v13 schema, otherwise Loki won't start. Exposed: the Loki config has no tsdb store or no v13 schema, and structured metadata isn't disabled through limits_config allow_structured_metadata: false or -validation.allow-structured-metadata=false.",
      "applicability": {
        "determination": "asserted",
        "exposure": {
          "op": "all",
          "of": [
            {
              "op": "any",
              "of": [
                {
                  "op": "resource",
                  "kind": "ConfigMap",
                  "of": [
                    {
                      "op": "text-line",
                      "path": "data[\"config.yaml\"]",
                      "pattern": "^\\s*-?\\s*store:\\s*[\"']?tsdb[\"']?\\s*$",
                      "state": "none"
                    }
                  ]
                },
                {
                  "op": "resource",
                  "kind": "ConfigMap",
                  "of": [
                    {
                      "op": "text-line",
                      "path": "data[\"config.yaml\"]",
                      "pattern": "^\\s*-?\\s*schema:\\s*[\"']?v13[\"']?\\s*$",
                      "state": "none"
                    }
                  ]
                }
              ]
            },
            {
              "op": "not",
              "of": [
                {
                  "op": "resource",
                  "kind": "ConfigMap",
                  "of": [
                    {
                      "op": "text-line",
                      "path": "data[\"config.yaml\"]",
                      "pattern": "^\\s*allow_structured_metadata:\\s*false\\b",
                      "state": "exists"
                    }
                  ]
                }
              ]
            },
            {
              "op": "not",
              "of": [
                {
                  "op": "cli-flag",
                  "name": "-validation.allow-structured-metadata",
                  "state": "equals",
                  "values": [
                    "false"
                  ]
                }
              ]
            }
          ]
        },
        "overlap": {
          "op": "any",
          "of": [
            {
              "op": "resource",
              "kind": "ConfigMap",
              "of": [
                {
                  "op": "text-line",
                  "path": "data[\"config.yaml\"]",
                  "pattern": "^\\s*-?\\s*store:\\s*[\"']?tsdb[\"']?\\s*$",
                  "state": "exists"
                },
                {
                  "op": "text-line",
                  "path": "data[\"config.yaml\"]",
                  "pattern": "^\\s*-?\\s*schema:\\s*[\"']?v13[\"']?\\s*$",
                  "state": "exists"
                }
              ]
            },
            {
              "op": "resource",
              "kind": "ConfigMap",
              "of": [
                {
                  "op": "text-line",
