  "output": {
    "action": "correct",
    "reason": "[ev-c143ccbe6259] says only that the `sidecar.istio.io/enableCoreDump` annotation was removed, so any workload that still sets it is exposed. The proposed condition only checks Pod objects. That misses workloads that set the annotation in a pod template, such as a Deployment, StatefulSet, DaemonSet, Job or CronJob, which is how it is usually set in manifests. I widened the condition to cover pod templates too. The evidence does not say where the annotation lives, so confidence is low.",
    "citations": [
      "ev-c143ccbe6259"
    ],
    "confidence": "low",
    "labels": [
      "wrong-applicability"
    ],
    "correction": {
      "statement": "The `sidecar.istio.io/enableCoreDump` annotation was removed in Istio 1.24.0. Exposed environments are those where a Pod, or the pod template of a Deployment, StatefulSet, DaemonSet, Job or CronJob, still sets this annotation. The `samples/proxy-coredump` sample shows the preferred ways to enable core dumps.",
      "applicability": {
        "determination": "asserted",
        "exposure": {
          "op": "any",
          "of": [
            {
              "op": "resource",
              "kind": "Pod",
              "of": [
                {
                  "op": "field",
                  "path": "metadata.annotations[\"sidecar.istio.io/enableCoreDump\"]",
                  "state": "set"
                }
              ]
            },
            {
              "op": "resource",
              "group": "apps",
              "kind": "Deployment",
              "of": [
                {
                  "op": "field",
                  "path": "spec.template.metadata.annotations[\"sidecar.istio.io/enableCoreDump\"]",
                  "state": "set"
                }
              ]
            },
            {
              "op": "resource",
              "group": "apps",
              "kind": "StatefulSet",
              "of": [
                {
                  "op": "field",
                  "path": "spec.template.metadata.annotations[\"sidecar.istio.io/enableCoreDump\"]",
                  "state": "set"
                }
              ]
            },
            {
              "op": "resource",
              "group": "apps",
              "kind": "DaemonSet",
              "of": [
                {
                  "op": "field",
                  "path": "spec.template.metadata.annotations[\"sidecar.istio.io/enableCoreDump\"]",
                  "state": "set"
                }
              ]
            },
            {
              "op": "resource",
              "group": "batch",
              "kind": "Job",
              "of": [
                {
                  "op": "field",
                  "path": "spec.template.metadata.annotations[\"sidecar.istio.io/enableCoreDump\"]",
                  "state": "set"
                }
              ]
            },
            {
              "op": "resource",
              "group": "batch",
              "kind": "CronJob",
              "of": [
                {
                  "op": "field",
                  "path": "spec.jobTemplate.spec.template.metadata.annotations[\"sidecar.istio.io/enableCoreDump\"]",
                  "state": "set"
                }
              ]
            }
          ]
        }
      }
    }
  }
