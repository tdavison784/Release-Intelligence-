  "proposal": {
    "id": "sp-b9735a8ef161",
    "candidateId": "sc-5851fd4cdacf",
    "task": "full",
    "provider": "anthropic",
    "assertion": {
      "subject": {
        "family": "config-key",
        "product": "strimzi",
        "path": "metric.reporters",
        "component": "kafka"
      },
      "change": {
        "type": "behavior-changed",
        "before": "\"JMXReporter enabled without explicit configuration\"",
        "after": "\"JMXReporter must be explicitly configured to be enabled\""
      },
      "applicability": {
        "exposure": {
          "op": "all",
          "of": [
            {
              "op": "resource",
              "of": [
                {
                  "op": "field",
                  "path": "spec.kafka.metrics",
                  "state": "unset"
                }
              ],
              "group": "kafka.strimzi.io",
              "version": "v1beta2",
              "kind": "Kafka"
            }
          ]
        },
        "overlap": {
          "op": "resource",
          "of": [
            {
              "op": "any",
              "of": [
                {
                  "op": "field",
                  "path": "spec.kafka.config[\"metric.reporters\"]",
                  "state": "matches",
                  "pattern": "JMXReporter"
                }
              ]
            }
          ],
          "group": "kafka.strimzi.io",
          "version": "v1beta2",
          "kind": "Kafka"
        }
      },
      "consequence": {
        "kind": "behavior-change",
        "exposedClass": "review-required",
        "statement": "Environments that relied on the implicit JMXReporter stop receiving JMX metrics once their brokers run Kafka 4.0.0, unless they enable metrics in .spec.kafka.metrics or explicitly add JMXReporter to metric.reporters.",
        "severity": "medium"
      },
      "statement": "Starting with Kafka 4.0.0, the JMXReporter is no longer enabled implicitly: to enable it you must either enable metrics in `.spec.kafka.metrics` or explicitly add JMXReporter in `metric.reporters`."
    },
    "suggestedClass": "review-required",
