        }
      },
      "consequence": {
        "kind": "permission-lost",
        "exposedClass": "action-required",
        "statement": "Kyverno controllers lose the wildcard view permission. Admission-time policies are not affected, but reports may be, and mutate and generate policies on custom resources may stop working because the controller may no longer be able to view those custom resources.",
        "remediation": "Follow the Role Based Access Controls documentation and grant Kyverno controllers view access to the custom resources your mutate/generate policies and reports depend on.",
        "severity": "medium"
      },
      "statement": "Kyverno 1.13 removes the wildcard view permission from its controllers and adds a role binding to the default `view` role instead. As a result, reports and mutate/generate policies on custom resources may break because the controller may no longer be able to view those resources."
    },
