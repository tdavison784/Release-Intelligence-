    "questionType": "applicability",
    "question": "For \"Store for retrieving remote schema: Previously LogCLI used to fetch remote schema from the store configured in `-boltdb.shipper.shared-store` when…\", which environments are exposed? Confirm or correct the exposure condition.",
    "proposed": {
      "applicability": {
        "exposure": {
          "op": "all",
          "of": [
            {
              "op": "cli-flag",
              "name": "-boltdb.shipper.shared-store",
              "component": "logcli",
              "state": "set"
            },
            {
              "op": "cli-flag",
              "name": "-remote-schema",
              "component": "logcli",
              "state": "equals",
              "values": [
                "\"true\""
              ]
            }
          ]
        },
        "overlap": {
          "op": "cli-flag",
          "name": "-schema-store",
          "component": "logcli",
          "state": "set"
        }
      },
      "statement": "LogCLI no longer takes the remote schema store from -boltdb.shipper.shared-store when -remote-schema is true; the new -schema-store flag replaces it."
    },
