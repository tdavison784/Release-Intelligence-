    "validator": "semvalidate.compat@v1",
    "assertion": {
      "subject": {
        "family": "product-relationship",
        "product": "cert-manager",
        "name": "venafi-vcert"
      },
      "change": {
        "type": "behavior-changed"
      },
      "applicability": {
        "exposure": {
          "op": "all",
          "of": [
            {
              "op": "resource",
              "of": [
                {
                  "op": "field",
                  "path": "spec.privateKey.algorithm",
                  "state": "equals",
                  "values": [
                    "\"RSA\""
                  ]
                },
                {
                  "op": "field",
                  "path": "spec.privateKey.size",
                  "state": "equals",
                  "values": [
                    "3072"
                  ]
                },
                {
                  "op": "ref",
                  "of": [
                    {
                      "op": "field",
                      "path": "spec.venafi.tpp",
                      "state": "set"
                    }
                  ],
                  "path": "spec.issuerRef"
                }
              ],
              "group": "cert-manager.io",
              "kind": "Certificate"
            }
          ]
        }
      },
      "consequence": {
        "kind": "behavior-change",
        "exposedClass": "review-required",
        "statement": "Venafi TPP certificate enrollment requesting an RSA 3072 bit key size, which previously did not work, now succeeds once cert-manager 1.17.0 is running; no operator action is needed to benefit from the fix.",
