      },
      "consequence": {
        "kind": "behavior-change",
        "exposedClass": "review-required",
        "statement": "Certificates that do not set spec.revisionHistoryLimit now get a default of 1, so only one CertificateRequest revision is kept.",
        "remediation": "If you need to keep more CertificateRequest revisions, set spec.revisionHistoryLimit explicitly on those Certificates.",
        "severity": "low"
      },
      "statement": "In cert-manager 1.18.0, Certificate spec.revisionHistoryLimit now defaults to 1, so Certificates that leave it unset keep only one CertificateRequest revision."
