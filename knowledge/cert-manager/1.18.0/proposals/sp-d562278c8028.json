        }
      },
      "consequence": {
        "kind": "behavior-change",
        "exposedClass": "review-required",
        "statement": "Certificates that do not set rotationPolicy now use the default Always instead of Never, so re-issuing them (for example with cmctl renew) generates a new private key rather than reusing the existing one.",
        "remediation": "To keep the old behaviour, explicitly set rotationPolicy: Never on your Certificate resources. Alternatively, turn off the feature gate in 1.18 and set rotationPolicy: Never before 1.19, when the feature can no longer be turned off.",
        "severity": "medium"
      },
      "statement": "In cert-manager 1.18.0, the default for Certificate spec.privateKey.rotationPolicy changed from Never to Always, so Certificates that leave this field unset now get a new private key each time they are re-issued."
    },
