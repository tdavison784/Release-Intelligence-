{
  "schemaVersion": "ri.dev/knowledge/v1alpha1",
  "kind": "validation",
  "validation": {
    "id": "val-67c3db6d3d3f",
    "candidateId": "sc-3e520936a5c1",
    "proposalId": "sp-8affeac49395",
    "validator": "semvalidate.canonical@v1",
    "assertion": {
      "subject": {
        "family": "config-key",
        "product": "traefik",
        "path": "consulCatalog.namespace"
      },
      "change": {
        "type": "removed",
        "replacedBy": {
          "family": "config-key",
          "product": "traefik",
          "path": "consulCatalog.namespaces"
        }
      },
      "applicability": {
        "exposure": {
          "op": "any",
          "of": [
            {
              "op": "cli-flag",
              "name": "--consulCatalog.namespace",
              "state": "set"
            },
            {
              "op": "env-var",
              "name": "TRAEFIK_CONSULCATALOG_NAMESPACE",
              "state": "set"
            },
            {
              "op": "resource",
              "of": [
                {
                  "op": "text-line",
                  "path": "data[\"traefik.yml\"]",
                  "state": "exists",
                  "pattern": "^\\s*namespace\\s*:"
                }
              ],
              "kind": "ConfigMap"
            },
            {
              "op": "resource",
              "of": [
                {
                  "op": "text-line",
                  "path": "data[\"traefik.yaml\"]",
                  "state": "exists",
                  "pattern": "^\\s*namespace\\s*:"
                }
              ],
              "kind": "ConfigMap"
            },
            {
              "op": "resource",
              "of": [
                {
                  "op": "text-line",
                  "path": "data[\"traefik.toml\"]",
                  "state": "exists",
                  "pattern": "^\\s*namespace\\s*="
                }
              ],
              "kind": "ConfigMap"
            }
          ]
        }
      },
      "consequence": {
        "kind": "workload-failure",
        "exposedClass": "action-required",
        "statement": "If the removed `namespace` option is still present in the configuration, Traefik v3 will not start.",
        "remediation": "Replace the ConsulCatalog provider `namespace` option with the `namespaces` option (a list) in the static configuration (file, CLI flag, or environment variable) before upgrading to Traefik v3.",
        "severity": "critical"
      },
      "statement": "The ConsulCatalog provider `namespace` static-configuration option, deprecated in v2, is removed in Traefik v3 and is now unsupported in a way that prevents Traefik from starting; the `namespaces` option must be used instead."
    },
    "checks": [
      {
        "aspect": "applicability",
        "outcome": "inconclusive",
        "rule": "canonical:config-key/removed",
        "detail": "no canonical exposure condition for config-key removed"
      }
    ],
    "checkedAt": "2026-10-02T16:10:34Z"
  }
}
