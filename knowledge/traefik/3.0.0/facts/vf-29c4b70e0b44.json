      "consequence": {
        "kind": "behavior-change",
        "exposedClass": "review-required",
        "statement": "Access logs, metrics and traces for internal routers/services (e.g. ping@internal) are no longer produced unless addInternals is set.",
        "remediation": "Set the addInternals option for AccessLogs, Metrics or Tracing if internal resource observability is needed.",
        "severity": "low"
      },
      "statement": "Internal Resources Observability: In v3, observability for internal routers or services (e.g.: `ping@internal`) is disabled by default"
