    "question": "For \"Fixed DestinationRules on same host but with different ExportTo can behave inconsistently, so stop merging the destinationRules when the exportTo attributes…\", which environments are exposed? Confirm or correct the exposure condition.",
    "proposed": {
      "applicability": {
        "exposure": {
          "op": "resource",
          "of": [
            {
              "op": "field",
              "path": "spec.exportTo",
              "state": "set"
            }
          ],
          "group": "networking.istio.io",
          "kind": "DestinationRule"
        },
        "overlap": {
          "op": "env-var",
          "name": "ENABLE_ENHANCED_DESTINATIONRULE_MERGE",
