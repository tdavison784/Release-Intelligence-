      "applicability": {
        "exposure": {
          "op": "resource",
          "of": [
            {
              "op": "field",
              "path": "spec.provider.aws",
              "state": "set"
            }
          ],
          "group": "external-secrets.io",
          "kind": "SecretStore"
        }
      },
      "statement": "external-secrets 0.16.0 adds a new field spec.provider.aws.prefix to the AWS secrets manager provider on SecretStore (also present on ClusterSecretStore per the target release schemas), giving AWS provider stores a new optional prefix setting."
    },
    "corrected": {
      "applicability": {
        "exposure": {
          "op": "any",
          "of": [
            {
              "op": "resource",
              "of": [
                {
                  "op": "field",
                  "path": "spec.provider.aws.service",
                  "state": "equals",
                  "values": [
                    "\"SecretsManager\""
                  ]
                },
                {
                  "op": "field",
                  "path": "spec.provider.aws.prefix",
                  "state": "set"
                }
              ],
              "group": "external-secrets.io",
              "kind": "SecretStore"
            },
            {
              "op": "resource",
              "of": [
                {
                  "op": "field",
                  "path": "spec.provider.aws.service",
                  "state": "equals",
                  "values": [
                    "\"SecretsManager\""
                  ]
                },
                {
                  "op": "field",
                  "path": "spec.provider.aws.prefix",
                  "state": "set"
                }
              ],
              "group": "external-secrets.io",
              "kind": "ClusterSecretStore"
            }
          ]
        }
      },
      "statement": "In 0.16.0 the AWS Secrets Manager provider starts using AWSProvider.prefix (spec.provider.aws.prefix), which before only Parameter Store used. Exposed: any SecretStore or ClusterSecretStore that uses the AWS provider with service SecretsManager and already sets spec.provider.aws.prefix."
    },
