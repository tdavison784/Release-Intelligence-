    "candidateId": "sc-25ca3183ac3f",
    "proposalId": "sp-51e5c123106a",
    "validator": "semvalidate.crd@v1",
    "assertion": {
      "subject": {
        "family": "crd-field",
        "product": "karpenter",
        "group": "karpenter.k8s.aws",
        "version": "v1beta1",
        "kind": "EC2NodeClass",
        "path": "spec.metadataOptions"
      },
      "change": {
        "type": "default-changed",
        "before": "\"{\\\"httpEndpoint\\\":\\\"enabled\\\",\\\"httpProtocolIPv6\\\":\\\"disabled\\\",\\\"httpPutResponseHopLimit\\\":2,\\\"httpTokens\\\":\\\"required\\\"}\"",
        "after": "\"{\\\"httpEndpoint\\\":\\\"enabled\\\",\\\"httpProtocolIPv6\\\":\\\"disabled\\\",\\\"httpPutResponseHopLimit\\\":1,\\\"httpTokens\\\":\\\"required\\\"}\""
      },
      "applicability": {
        "exposure": {
          "op": "resource",
          "of": [
            {
              "op": "field",
              "path": "spec.metadataOptions",
              "state": "unset"
            }
          ],
          "group": "karpenter.k8s.aws",
          "version": "v1beta1",
          "kind": "EC2NodeClass"
        },
        "overlap": {
          "op": "resource",
          "of": [
            {
              "op": "field",
              "path": "spec.metadataOptions",
              "state": "set"
            }
          ],
          "group": "karpenter.k8s.aws",
          "version": "v1beta1",
          "kind": "EC2NodeClass"
        }
      },
      "consequence": {
        "kind": "behavior-change",
        "exposedClass": "review-required",
        "statement": "Newly created EC2NodeClass objects that leave spec.metadataOptions unset will now receive a default with httpPutResponseHopLimit 1 instead of 2 (httpEndpoint \"enabled\", httpProtocolIPv6 \"disabled\" and httpTokens \"required\" are unchanged)",
        "remediation": "If the previous default is required, set spec.metadataOptions (or its httpPutResponseHopLimit) explicitly on the EC2NodeClass."
      },
      "statement": "In the karpenter.k8s.aws/v1beta1 schema of EC2NodeClass, the default value of spec.metadataOptions changed from httpPutResponseHopLimit 2 to httpPutResponseHopLimit 1 (the other default entries httpEndpoint=enabled, httpProtocolIPv6=disabled, httpTokens=required are unchanged)."
    },
    "checks": [
      {
        "aspect": "subject",
        "outcome": "confirmed",
        "rule": "crd-schema:field",
        "detail": "karpenter.k8s.aws EC2NodeClass spec.metadataOptions is in the schema of both releases"
      },
      {
        "aspect": "change",
        "outcome": "confirmed",
        "rule": "crd-schema:default",
        "detail": "the v1beta1 schema default of karpenter.k8s.aws EC2NodeClass spec.metadataOptions is {\"httpEndpoint\":\"enabled\",\"httpProtocolIPv6\":\"disabled\",\"httpPutResponseHopLimit\":2,\"httpTokens\":\"required\"} at the source and {\"httpEndpoint\":\"enabled\",\"httpProtocolIPv6\":\"disabled\",\"httpPutResponseHopLimit\":1,\"httpTokens\":\"required\"} at the target"
      }
    ],
