    ],
    "assertion": {
      "subject": {
        "family": "crd-field",
        "product": "karpenter",
        "group": "karpenter.k8s.aws",
        "version": "v1beta1",
        "kind": "EC2NodeClass",
        "path": "spec.metadataOptions"
      },
      "change": {
        "type": "default-changed",
        "before": "\"{\\\"httpEndpoint\\\":\\\"enabled\\\",\\\"httpProtocolIPv6\\\":\\\"disabled\\\",\\\"httpPutResponseHopLimit\\\":2,\\\"httpTokens\\\":\\\"required\\\"}\"",
        "after": "\"{\\\"httpEndpoint\\\":\\\"enabled\\\",\\\"httpProtocolIPv6\\\":\\\"disabled\\\",\\\"httpPutResponseHopLimit\\\":1,\\\"httpTokens\\\":\\\"required\\\"}\""
      },
      "applicability": {
        "exposure": {
          "op": "resource",
          "of": [
            {
              "op": "field",
              "path": "spec.metadataOptions",
              "state": "unset"
            }
          ],
          "group": "karpenter.k8s.aws",
          "version": "v1beta1",
          "kind": "EC2NodeClass"
        },
        "overlap": {
          "op": "resource",
          "of": [
            {
              "op": "field",
              "path": "spec.metadataOptions",
              "state": "set"
            }
          ],
          "group": "karpenter.k8s.aws",
          "version": "v1beta1",
          "kind": "EC2NodeClass"
        }
      },
      "consequence": {
        "kind": "behavior-change",
        "exposedClass": "review-required",
        "statement": "v1beta1 EC2NodeClass objects that leave spec.metadataOptions unset now get the default httpPutResponseHopLimit 1 instead of 2. The httpEndpoint \"enabled\", httpProtocolIPv6 \"disabled\" and httpTokens \"required\" defaults are unchanged. Objects that set spec.metadataOptions but omit httpPutResponseHopLimit still get the field-level default of 2.",
        "remediation": "If a hop limit of 2 is needed, set spec.metadataOptions explicitly on the EC2NodeClass, including httpPutResponseHopLimit: 2.",
        "severity": "medium"
      },
      "statement": "EC2NodeClass v1beta1 schema: 1 default changed: `spec.metadataOptions`"
    },
