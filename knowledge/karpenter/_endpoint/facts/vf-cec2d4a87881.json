    "assertion": {
      "subject": {
        "family": "gvk",
        "product": "karpenter",
        "group": "karpenter.sh",
        "version": "v1",
        "kind": "NodePool"
      },
      "change": {
        "type": "value-changed",
        "before": "\"v1beta1\"",
        "after": "\"v1\""
      },
      "applicability": {
        "exposure": {
          "op": "resource",
          "of": [
            {
              "op": "field",
              "path": "status.storedVersions[]",
              "state": "equals",
              "values": [
                "\"v1beta1\""
              ]
            }
          ],
          "group": "apiextensions.k8s.io",
          "kind": "CustomResourceDefinition",
          "name": "nodepools.karpenter.sh"
        }
      },
      "consequence": {
        "kind": "migration-required",
        "exposedClass": "action-required",
        "statement": "Existing NodePool objects stay stored as v1beta1 until rewritten, so the operator must run a storage version migration (re-write all NodePool objects) and update status.storedVersions on the nodepools.karpenter.sh CRD before a later release removes v1beta1.",
        "remediation": "Run a storage version migration (re-write all NodePool objects so they are stored as v1) and update status.storedVersions on the nodepools.karpenter.sh CRD before upgrading to a later release that removes v1beta1.",
        "severity": "medium"
      },
      "statement": "Storage version of `nodepools.karpenter.sh` changes v1beta1 → v1"
    },
