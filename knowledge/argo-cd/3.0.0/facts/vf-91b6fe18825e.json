    "candidates": [
      "sc-819834200127"
    ],
    "assertion": {
      "subject": {
        "family": "config-key",
        "product": "argo-cd",
        "path": "resource.compareoptions.ignoreResourceStatusField",
        "component": "argocd-cm"
      },
      "change": {
        "type": "default-changed",
        "before": "\"crd\"",
        "after": "\"all\""
      },
      "applicability": {
        "exposure": {
          "op": "all",
          "of": [
            {
              "op": "edge-from-version",
              "state": "in-range",
              "range": "<3.0.0"
            },
            {
              "op": "resource",
              "of": [
                {
                  "op": "any",
                  "of": [
                    {
                      "op": "field",
                      "path": "data[\"resource.compareoptions\"]",
                      "state": "unset"
                    },
                    {
                      "op": "text-line",
                      "path": "data[\"resource.compareoptions\"]",
                      "state": "none",
                      "pattern": "ignoreResourceStatusField"
                    }
                  ]
                }
              ],
              "kind": "ConfigMap",
              "name": "argocd-cm"
            }
          ]
        },
        "overlap": {
          "op": "resource",
          "of": [
            {
              "op": "text-line",
              "path": "data[\"resource.compareoptions\"]",
              "state": "exists",
              "pattern": "ignoreResourceStatusField.*crd"
            }
          ],
          "kind": "ConfigMap",
          "name": "argocd-cm"
        }
      },
      "consequence": {
        "kind": "behavior-change",
        "exposedClass": "review-required",
        "statement": "Status field differences are no longer detected by default for all resources; previously only custom resources had status fields ignored by default.",
        "remediation": "If you rely on detecting status field differences, set ignoreResourceStatusField to 'crd' in the argocd-cm ConfigMap's resource.compareoptions to preserve v2 behavior.",
        "severity": "medium"
      },
      "statement": "Ignoring status field from differences by default: By default, the compare options to ignore the status field has been changed from `crd` to `all` resources"
    },
