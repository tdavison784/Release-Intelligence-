    "assertion": {
      "subject": {
        "family": "protocol-behavior",
        "product": "argo-cd",
        "name": "webhook-repo-url-matching"
      },
      "change": {
        "type": "behavior-changed"
      },
      "applicability": {
        "exposure": {
          "op": "all",
          "of": [
            {
              "op": "any",
              "of": [
                {
                  "op": "resource",
                  "of": [
                    {
                      "op": "field",
                      "path": "spec.source.repoURL",
                      "state": "matches",
                      "pattern": "(?i)^(ssh://)?([^@/]+@)?(ssh|altssh)\\.|^https?://[^@/]+@"
                    }
                  ],
                  "group": "argoproj.io",
                  "kind": "Application"
                },
                {
                  "op": "resource",
                  "of": [
                    {
                      "op": "field",
                      "path": "spec.sources[].repoURL",
                      "state": "matches",
                      "pattern": "(?i)^(ssh://)?([^@/]+@)?(ssh|altssh)\\.|^https?://[^@/]+@"
                    }
                  ],
                  "group": "argoproj.io",
                  "kind": "Application"
                },
                {
                  "op": "resource",
                  "of": [
                    {
                      "op": "field",
                      "path": "spec.generators[].git.repoURL",
                      "state": "matches",
                      "pattern": "(?i)^(ssh://)?([^@/]+@)?(ssh|altssh)\\.|^https?://[^@/]+@"
                    }
                  ],
                  "group": "argoproj.io",
                  "kind": "ApplicationSet"
                },
                {
                  "op": "resource",
                  "of": [
                    {
                      "op": "field",
                      "path": "spec.generators[].matrix.generators[].git.repoURL",
                      "state": "matches",
                      "pattern": "(?i)^(ssh://)?([^@/]+@)?(ssh|altssh)\\.|^https?://[^@/]+@"
                    }
                  ],
                  "group": "argoproj.io",
                  "kind": "ApplicationSet"
                }
              ]
            },
            {
              "op": "undecidable",
              "reason": "runtime-behavior-gap",
              "needed": "whether the git provider delivers webhook events to Argo CD (API server or ApplicationSet webhook) for these repositories"
            }
          ]
        }
      },
      "consequence": {
        "kind": "behavior-change",
        "exposedClass": "review-required",
        "statement": "Webhook payloads now match repo URLs that use ssh or altssh subdomains; environments receiving webhooks for such repositories see those payloads match (enabling webhook-triggered handling) where they previously did not.",
        "remediation": "No operator action required; verify that webhook events for repositories whose URLs use ssh/altssh subdomains now trigger the expected refreshes.",
        "severity": "low"
      },
