      "consequence": {
        "kind": "permission-lost",
        "exposedClass": "action-required",
        "statement": "Users whose policies grant `update` or `delete` on an application lose that access to the application's sub-resources (managed resources) unless new `update/*` or `delete/*` policies are defined.",
        "remediation": "Define policies allowing `update/*` or `delete/*` on the Application's managed resources, or set server.rbac.disableApplicationFineGrainedRBACInheritance to false in argocd-cm to preserve v2 behavior.",
