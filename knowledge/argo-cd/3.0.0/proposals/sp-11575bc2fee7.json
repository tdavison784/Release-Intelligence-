    "provider": "anthropic",
    "assertion": {
      "subject": {
        "family": "rbac-permission",
        "product": "argo-cd",
        "name": "applications/update, applications/delete (sub-resource inheritance)"
      },
      "change": {
        "type": "behavior-changed",
        "before": "\"policies granting update or delete to an application applied to its sub-resources\"",
        "after": "\"update or delete actions only apply to the application itself; sub-resources require separate update/* or delete/* policies\""
      },
      "applicability": {
        "exposure": {
          "op": "all",
          "of": [
            {
              "op": "gvk-in-use",
              "group": "argoproj.io",
              "kind": "Application"
            },
            {
              "op": "any",
              "of": [
                {
                  "op": "resource",
                  "of": [
                    {
                      "op": "text-line",
                      "path": "rules[].verbs",
                      "state": "exists",
                      "pattern": "(^|,)\\s*(update|delete)(\\s|,|$)"
                    }
                  ],
                  "kind": "ClusterRole"
                },
                {
                  "op": "resource",
                  "of": [
                    {
                      "op": "text-line",
                      "path": "rules[].verbs",
                      "state": "exists",
                      "pattern": "(^|,)\\s*(update|delete)(\\s|,|$)"
                    }
                  ],
                  "kind": "Role"
                }
              ]
            },
            {
              "op": "values-key",
              "path": "server.rbac.disableApplicationFineGrainedRBACInheritance",
              "state": "unset"
            }
          ]
        },
        "overlap": {
          "op": "values-key",
          "path": "server.rbac.disableApplicationFineGrainedRBACInheritance",
          "state": "equals",
          "values": [
            "false"
          ]
        }
      },
      "consequence": {
        "kind": "permission-lost",
        "exposedClass": "action-required",
        "statement": "RBAC policies granting update or delete permissions on Applications no longer automatically grant those permissions on managed sub-resources; operators must define separate policies with update/* or delete/* verbs to maintain access to application-managed resources.",
        "remediation": "Define new RBAC policies with update/* and delete/* verbs for managed resources, or set server.rbac.disableApplicationFineGrainedRBACInheritance to false in argocd-cm to preserve v2 behavior.",
        "severity": "high"
      },
      "statement": "Fine-grained RBAC policies granting update or delete to an Application no longer apply to its sub-resources by default; new policies granting update/* or delete/* are required for managed resources, with v2 behavior restorable via server.rbac.disableApplicationFineGrainedRBACInheritance=false in argocd-cm."
    },
