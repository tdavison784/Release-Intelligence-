    "question": "For \"Ignoring all status updates and high churn mutations: Argo CD manifest now contains a default configuration for `resource.customizations.ignoreResourceUpdates`…\", which environments are exposed? Confirm or correct the exposure condition.",
    "proposed": {
      "applicability": {
        "exposure": {
          "op": "all",
          "of": [
