    "questionType": "applicability",
    "question": "For \"Ignoring status field from differences by default: By default, the compare options to ignore the status field has been changed from `crd` to `all` resources\", which environments are exposed? Confirm or correct the exposure condition.",
    "proposed": {
      "applicability": {
        "exposure": {
          "op": "all",
          "of": [
            {
              "op": "edge-from-version",
              "state": "in-range",
              "range": "<3.0.0"
            },
            {
              "op": "resource",
