                      "state": "none",
                      "pattern": "ignoreResourceStatusField"
                    }
                  ]
                }
              ],
              "kind": "ConfigMap",
              "name": "argocd-cm"
            }
          ]
        },
        "overlap": {
          "op": "resource",
          "of": [
            {
              "op": "text-line",
              "path": "data[\"resource.compareoptions\"]",
              "state": "exists",
