      "consequence": {
        "kind": "behavior-change",
        "exposedClass": "review-required",
        "statement": "When MTU is auto-detected, Cilium now picks the lowest MTU across all external interfaces rather than the primary interface's MTU, so the effective MTU may differ after upgrade.",
        "remediation": "If a specific MTU is needed, set it explicitly via the `MTU` helm option, the `--mtu` agent flag or the `mtu` option in CNI configuration.",
        "severity": "low"
