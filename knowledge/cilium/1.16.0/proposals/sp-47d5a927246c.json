      "change": {
        "type": "behavior-changed",
        "before": "\"IPs observed for toFQDNs selectors were each assigned separate cidr identities\"",
        "after": "\"IPs observed in DNS lookups are labeled with the selectors toFQDNs matching them\""
      },
