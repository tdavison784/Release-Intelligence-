    "assertion": {
      "subject": {
        "family": "helm-value",
        "product": "cilium",
        "path": "bpf.enableTCX"
      },
      "change": {
        "type": "behavior-changed"
      },
      "applicability": {
        "exposure": {
          "op": "all",
          "of": [
            {
              "op": "cluster-version",
              "name": "linux",
              "state": "in-range",
              "range": ">=6.6.0"
            },
            {
              "op": "not",
              "of": [
                {
                  "op": "values-key",
                  "path": "bpf.enableTCX",
                  "state": "equals",
                  "values": [
                    "\"false\""
                  ]
                }
              ]
            }
          ]
        },
        "overlap": {
          "op": "values-key",
          "path": "bpf.enableTCX",
          "state": "equals",
          "values": [
            "\"false\""
          ]
        }
      },
      "consequence": {
        "kind": "behavior-change",
        "exposedClass": "review-required",
        "statement": "Cilium attaches tc BPF programs via tcx links by default on kernels 6.6+, which may conflict with third-party old-style tc BPF users.",
        "remediation": "Set bpf.enableTCX=false in Helm to continue with old-style tc BPF attachment."
      },
      "statement": "For Linux kernels of version 6.6 or newer, Cilium by default switches to tcx BPF links for attaching its tc BPF programs in the core datapath for better…"
