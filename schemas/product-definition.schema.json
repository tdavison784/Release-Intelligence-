{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ri.dev/schemas/product-definition/v1alpha1.json",
  "title": "ProductDefinition",
  "description": "Declarative description of a software product's authoritative release channels, the artifacts it publishes and how artifact versions relate to release versions. String fields marked 'template' may use Go text/template placeholders such as {{.Tag}}, {{.Version}}, {{.Major}}, {{.Minor}}, {{.Line}}, {{.PrevLine}}, {{.PrevTag}}, {{.ArtifactVersion}}. Source templates may additionally follow a pinned component's version with {{.ArtifactVersionOf \"artifact-id\"}}, which renders the version the named artifact resolved to (its version.strategy must be template, field or pattern).",
  "type": "object",
  "additionalProperties": false,
  "required": ["apiVersion", "kind", "id", "name", "versioning", "sources", "artifacts"],
  "properties": {
    "apiVersion": {"const": "ri.dev/v1alpha1"},
    "kind": {"const": "ProductDefinition"},
    "id": {"$ref": "#/$defs/dnsLabel"},
    "name": {"type": "string", "minLength": 1},
    "description": {"type": "string"},
    "homepage": {"type": "string", "format": "uri"},
    "versioning": {
      "type": "object",
      "additionalProperties": false,
      "required": ["scheme"],
      "properties": {
        "scheme": {"enum": ["semver"]},
        "tagPrefix": {"type": "string"},
        "tagPattern": {"type": "string", "description": "Regex with a named group (?P<version>...) holding the semantic version, or named component groups (?P<major>...) with optional (?P<minor>...), (?P<patch>...) (default 0) and (?P<prerelease>...), assembled into major.minor.patch[-prerelease]; e.g. '^REL_(?P<major>\\d+)_(?P<patch>\\d+)$' reads REL_17_2 as 17.0.2."},
        "lineage": {"enum": ["minor", "linear"]},
        "includePrereleases": {"type": "boolean"}
      }
    },
    "sources": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/source"}},
    "artifacts": {"type": "array", "items": {"$ref": "#/$defs/artifact"}},
    "lifecycle": {
      "type": "array",
      "description": "Statements that the product, or the releases matching 'versions', is deprecated or end-of-life, evidenced by the note items of the cited sources.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["state", "summary", "sources"],
        "properties": {
          "state": {"enum": ["deprecated", "end-of-life"]},
          "since": {"type": "string", "pattern": "^\\d{4}-(0[1-9]|1[0-2])(-(0[1-9]|[12]\\d|3[01]))?$", "description": "YYYY-MM-DD or YYYY-MM."},
          "versions": {"$ref": "#/$defs/constraint"},
          "summary": {"type": "string", "minLength": 1},
          "sources": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/dnsLabel"}}
        }
      }
    },
    "configSources": {
      "type": "array",
      "description": "Where the product reads its configuration (upstream-documented channels), so applicability conditions can use a decidable predicate. Each entry cites upstream documentation.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "channel", "summary", "references"],
        "properties": {
          "id": {"$ref": "#/$defs/dnsLabel"},
          "channel": {"enum": ["configmap-file", "config-file", "helm-values", "cli-flags", "env-vars", "feature-gates", "custom-resource"]},
          "component": {"type": "string"},
          "summary": {"type": "string", "minLength": 1},
          "file": {"type": "string", "minLength": 1},
          "format": {"enum": ["yaml", "json", "toml", "ini", "text", "csv", "hcl", "conf"]},
          "configMap": {"type": "string"},
          "valuesPath": {"type": "string", "minLength": 1},
          "flag": {"type": "string", "pattern": "^-"},
          "resource": {
            "type": "object",
            "additionalProperties": false,
            "required": ["kind"],
            "properties": {"group": {"type": "string"}, "kind": {"type": "string", "minLength": 1}}
          },
          "references": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["url", "quote"],
              "properties": {
                "url": {"type": "string", "pattern": "^https://"},
                "quote": {"type": "string", "minLength": 1, "maxLength": 400}
              }
            }
          }
        }
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["method"],
      "properties": {
        "method": {"type": "string"},
        "author": {"type": "string"},
        "updated": {"type": "string"},
        "validatedReleases": {"$ref": "#/$defs/stringList"},
        "notes": {"type": "string"}
      }
    }
  },
  "$defs": {
    "dnsLabel": {"type": "string", "pattern": "^[a-z0-9]([a-z0-9-]*[a-z0-9])?$"},
    "stringList": {"type": "array", "items": {"type": "string"}},
    "constraint": {"type": "string", "description": "Semver constraint on the release version, e.g. \">= 1.14.0\"."},
    "exceptions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["versions", "reason"],
        "properties": {
          "versions": {"type": "array", "minItems": 1, "items": {"type": "string"}},
          "reason": {"type": "string", "minLength": 1}
        }
      }
    },
    "role": {"enum": ["versions", "release-notes", "changelog", "upgrade-guide", "compatibility", "security"]},
    "category": {"enum": ["feature", "bugfix", "deprecation", "removal", "migration", "configuration", "helm-values", "crd-schema", "api", "compatibility", "security", "artifact", "dependency", "other"]},
    "locator": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind"],
      "properties": {
        "kind": {"enum": ["github-releases", "github-advisories", "git-tags", "repo-file", "repo-dir", "git-log", "http", "helm-repo", "oci", "helm-git", "chart-tgz"]},
        "repository": {"type": "string"},
        "ref": {"type": "string"},
        "baseRef": {"type": "string"},
        "path": {"type": "string"},
        "glob": {"type": "string"},
        "url": {"type": "string"},
        "chart": {"type": "string"},
        "tagPattern": {"type": "string"}
      },
      "allOf": [
        {"if": {"properties": {"kind": {"enum": ["github-releases", "github-advisories", "git-tags", "oci"]}}}, "then": {"required": ["repository"]}},
        {"if": {"properties": {"kind": {"enum": ["repo-file", "repo-dir"]}}}, "then": {"required": ["repository", "path"]}},
        {"if": {"properties": {"kind": {"const": "git-log"}}}, "then": {"required": ["repository", "ref"]}},
        {"if": {"properties": {"kind": {"const": "http"}}}, "then": {"required": ["url"]}},
        {"if": {"properties": {"kind": {"const": "helm-repo"}}}, "then": {"required": ["url", "chart"]}},
        {"if": {"properties": {"kind": {"const": "chart-tgz"}}}, "then": {"required": ["url"]}},
        {"if": {"properties": {"kind": {"const": "helm-git"}}}, "then": {"required": ["repository", "path", "tagPattern"]}}
      ]
    },
    "columnSpec": {
      "type": "object",
      "additionalProperties": false,
      "required": ["platform", "headers"],
      "properties": {
        "platform": {"type": "string"},
        "kind": {"enum": ["supported", "tested", "minimum", "maximum"]},
        "headers": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "separator": {"type": "string"},
        "part": {"type": "integer", "minimum": 0},
        "reduce": {"enum": ["major", "minor"], "description": "coarsen each version of a comma-joined cell to its major/minor line and drop duplicates"}
      }
    },
    "extract": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type"],
      "properties": {
        "type": {"enum": ["whole", "markdown-section", "markdown-table", "yaml-records", "release-note-yaml"]},
        "format": {"enum": ["markdown", "docbook", "rst", "adoc", "html"], "description": "Markup of the document. 'docbook' (SGML/XML), 'rst' (reStructuredText), 'adoc' (AsciiDoc) and 'html' are rendered as line-preserving markdown before extraction; docbook and html only with types whole and markdown-section, rst and adoc also with markdown-table (their tables become pipe tables)."},
        "heading": {"type": "string"},
        "keyColumns": {"$ref": "#/$defs/stringList"},
        "keyMatch": {"type": "string"},
        "columns": {"type": "array", "items": {"$ref": "#/$defs/columnSpec"}},
        "tableHeading": {"type": "string"},
        "labelParagraphs": {"type": "string"}, "where": {"type": "object", "additionalProperties": {"type": "string"}, "description": "yaml-records: keep records whose field matches the regex"},
        "collect": {"type": "boolean", "description": "yaml-records: merge every record passing where into one row (cells = distinct values joined with ', '); no key needed"},
        "listItems": {"type": "boolean", "description": "structural reading: every list item is one item and section prose is its own item, instead of a prose-led section folding its list (docbook/rst conversions always use it)"}
      },
      "allOf": [
        {"if": {"properties": {"type": {"const": "markdown-section"}}}, "then": {"required": ["heading"]}},
        {"if": {"properties": {"type": {"enum": ["markdown-table", "yaml-records"]}}, "not": {"required": ["collect"]}}, "then": {"required": ["keyColumns", "keyMatch", "columns"]}},
        {"if": {"required": ["collect"]}, "then": {"required": ["columns"]}}
      ]
    },
    "classifyRule": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "section": {"type": "string"},
        "text": {"type": "string"},
        "category": {"$ref": "#/$defs/category"},
        "breaking": {"type": "boolean"},
        "actionRequired": {"type": "boolean"},
        "skip": {"type": "boolean"}
      },
      "anyOf": [{"required": ["section"]}, {"required": ["text"]}]
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "roles", "locator"],
      "properties": {
        "id": {"$ref": "#/$defs/dnsLabel"},
        "roles": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/role"}},
        "locator": {"$ref": "#/$defs/locator"},
        "extract": {"$ref": "#/$defs/extract"},
        "classify": {"type": "array", "items": {"$ref": "#/$defs/classifyRule"}},
        "availability": {"$ref": "#/$defs/constraint"},
        "releaseKinds": {"type": "array", "items": {"enum": ["major", "minor", "patch"]}},
        "priority": {"type": "integer"},
        "fallbackGroup": {"$ref": "#/$defs/dnsLabel"},
        "exceptions": {"$ref": "#/$defs/exceptions"},
        "validatedAgainst": {"$ref": "#/$defs/stringList"},
        "notes": {"type": "string"}
      }
    },
    "versionRelation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["strategy"],
      "properties": {
        "strategy": {"enum": ["template", "lookup", "field", "pattern", "independent"]},
        "template": {"type": "string"},
        "field": {"type": "string", "description": "lookup: index field (e.g. appVersion); field: YAML path read from the from document (e.g. dependencies[name=kube-state-metrics].version)"},
        "match": {"type": "string"},
        "from": {"$ref": "#/$defs/locator", "description": "field/pattern strategy: the document the version is read from, rendered with the release context (repo-file or http)"},
        "pattern": {"type": "string", "description": "pattern strategy: regular expression (release-context template) whose named capture group (?P<version>…) is the artifact version, applied to the raw text of the from document — the text-mode twin of field, for pins inside strings (kustomize remote-resource URLs, go.mod require lines)"},
        "select": {"enum": ["latest", "earliest", "all"]}
      },
      "allOf": [
        {"if": {"properties": {"strategy": {"const": "template"}}}, "then": {"required": ["template"]}},
        {"if": {"properties": {"strategy": {"const": "lookup"}}}, "then": {"required": ["field", "match"]}},
        {"if": {"properties": {"strategy": {"const": "field"}}}, "then": {"required": ["field", "from"]}},
        {"if": {"properties": {"strategy": {"const": "pattern"}}}, "then": {"required": ["pattern", "from"]}}
      ]
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "type", "name", "version", "channels"],
      "properties": {
        "id": {"$ref": "#/$defs/dnsLabel"},
        "type": {"enum": ["source-release", "helm-chart", "container-image", "operator", "binary", "package", "manifest", "crd", "documentation"]},
        "name": {"type": "string", "minLength": 1},
        "description": {"type": "string"},
        "version": {"$ref": "#/$defs/versionRelation"},
        "channels": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/locator"}},
        "references": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["artifact", "pattern"],
            "properties": {"artifact": {"$ref": "#/$defs/dnsLabel"}, "pattern": {"type": "string"}}
          }
        },
        "contents": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["kind"],
            "properties": {
              "kind": {"enum": ["helm-values", "chart-metadata", "crds", "image-refs", "lines"]},
              "locator": {"$ref": "#/$defs/locator", "description": "Where the content is read from. Kinds helm-repo, oci (a chart repository) and chart-tgz read the packaged chart archive (the published-artifact representation); http, repo-file and repo-dir read documents. When omitted, the artifact's first readable channel is used."},
              "compareWith": {"$ref": "#/$defs/locator", "description": "Alternate representation of the same content (e.g. the published chart archive vs the source tree), read for comparison only; a representation.divergence fact records when they differ so preferring one representation is never silent."},
              "availability": {"$ref": "#/$defs/constraint"},
              "stripPrefix": {"type": "string"},
              "ignoreKeys": {
                "type": "array",
                "items": {"type": "string", "minLength": 1},
                "description": "helm-values only: dotted values keys (after stripPrefix) excluded from the snapshot, for keys rewritten by release tooling at build time (e.g. image hub/tag placeholders in source-tree values). An entry ending in .* also matches every key below it."
              },
              "pattern": {"type": "string", "description": "lines only: RE2 pattern applied to every line of the document; matching lines (or the first capture group) are kept, trimmed and de-duplicated. The two releases of an edge are compared as sets, so a statement that stays put is no change."},
              "label": {"type": "string", "description": "lines only: names the document in the changes; default the base name of the document."}
            }
          }
        },
        "availability": {"$ref": "#/$defs/constraint"},
        "optional": {"type": "boolean"},
        "exceptions": {"$ref": "#/$defs/exceptions"},
        "validatedAgainst": {"$ref": "#/$defs/stringList"},
        "notes": {"type": "string"}
      }
    }
  }
}
